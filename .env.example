# Database Configuration
# Copy this file to .env and fill in your values
DB_PASSWORD=your_password_here

# Optional settings
# DB_USER=postgres
# POSTGRES_VERSION=18-alpine
# ADMINER_VERSION=5.4.2

# API_PORT=5079
# BLAZOR_PORT=5022
# REACT_PORT=62000

API_BASE_URL=http://localhost:5079
VITE_API_URL=http://localhost:5079/api/v1

# === RabbitMQ / Notifications ===
# RABBITMQ_VERSION=3-management
# RABBITMQ_PORT=5672
# RABBITMQ_MGMT_PORT=15672
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest
# NOTIFICATIONS_PORT=5120

# SMTP (notifications service) — empty = console only
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=no-reply@clientopsportal.com