@page
@model ClientOpsPortal.Services.Auth.Pages.LoggedOutModel
@{
    Layout = null;
    var title = "ClientOps Portal — Signed out";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container" style="max-width: 420px; margin-top: 8vh;">
        <div class="card shadow-sm">
            <div class="card-body p-4 text-center">
                <div style="margin: 0 auto 16px; width: 56px; height: 56px;">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width: 56px; height: 56px;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                </div>
                <h1 class="h4 mb-2">Вы вышли из системы</h1>
                <p class="text-muted mb-4">Сеанс завершен. Для продолжения работы войдите в систему снова.</p>
                <a href="@Model.LoginUrl" class="btn btn-primary w-100">Войти снова</a>
            </div>
        </div>
    </div>
</body>
</html>
