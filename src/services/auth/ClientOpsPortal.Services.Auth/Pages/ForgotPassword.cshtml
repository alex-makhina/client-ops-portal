@page
@model ClientOpsPortal.Services.Auth.Pages.ForgotPasswordModel
@{
    Layout = null;
    var title = "ClientOps Portal — Восстановление пароля";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container" style="max-width: 420px; margin-top: 8vh;">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Восстановление пароля</h1>
                <p class="text-muted mb-4">Введите логин — ссылка для сброса пароля будет отправлена на почту</p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
                }

                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success py-2">@Model.SuccessMessage</div>
                }

                @if (string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <form method="post">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div class="mb-3">
                            <label asp-for="LoginIdentifier" class="form-label">Логин</label>
                            <input asp-for="LoginIdentifier" class="form-control" autocomplete="username" autofocus required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Отправить ссылку</button>
                    </form>
                }

                <div class="mt-3 text-center">
                    <a href="@Model.LoginUrl">Вернуться ко входу</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
