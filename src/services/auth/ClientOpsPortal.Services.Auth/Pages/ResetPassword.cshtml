@page
@model ClientOpsPortal.Services.Auth.Pages.ResetPasswordModel
@{
    Layout = null;
    var title = "ClientOps Portal — Set password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container" style="max-width: 420px; margin-top: 8vh;">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Установка пароля</h1>
                <p class="text-muted mb-4">Придумайте надежный пароль для вашей учетной записи</p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
                }

                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success py-2">@Model.SuccessMessage</div>
                    <div class="text-center mt-3">
                        <a href="@Model.LoginUrl" class="btn btn-primary">Перейти ко входу</a>
                    </div>
                }
                else if (string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <form method="post">
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="Token" />
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">Новый пароль</label>
                            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Подтвердите пароль</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Установить пароль</button>
                    </form>
                }
            </div>
        </div>
    </div>
</body>
</html>
