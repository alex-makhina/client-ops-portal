@page "/manager/register-abonent"
@attribute [Authorize(Roles = "Manager")]

@using ClientOpsPortal.Web.Features.AbonentRegistration.Models
@using ClientOpsPortal.Web.Features.AbonentRegistration.Services

@inject IAbonentRegistrationService AbonentRegistrationService
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<RadzenCard Style="max-width: 600px; margin: 40px auto;">
    <h3 class="mb-0">Регистрация нового абонента</h3>
    <div class="p-3">
        <RadzenAlert @bind-Visible="@showError" Severity="AlertStyle.Danger" Style="margin-bottom: 16px;">
            @errorMessage
        </RadzenAlert>
        <RadzenAlert @bind-Visible="@showSuccess" Severity="AlertStyle.Success" Style="margin-bottom: 16px;">
            @successMessage
        </RadzenAlert>

        <RadzenTextBox @bind-Value="@request.IdentificationNumber" Placeholder="Идентификационный номер (ИНН)" Style="margin-bottom: 12px; width: 100%;" />
        <RadzenTextBox @bind-Value="@request.LastName" Placeholder="Фамилия" Style="margin-bottom: 12px; width: 100%;" />
        <RadzenTextBox @bind-Value="@request.FirstName" Placeholder="Имя" Style="margin-bottom: 12px; width: 100%;" />
        <RadzenTextBox @bind-Value="@request.MiddleName" Placeholder="Отчество (необязательно)" Style="margin-bottom: 12px; width: 100%;" />
        <RadzenTextBox @bind-Value="@request.Email" Placeholder="Email" Style="margin-bottom: 12px; width: 100%;" />
        <RadzenTextBox @bind-Value="@request.PhoneNumber" Placeholder="Номер телефона (необязательно)" Style="margin-bottom: 12px; width: 100%;" />
        <RadzenTextBox @bind-Value="@request.Address" Placeholder="Адрес (необязательно)" Style="margin-bottom: 20px; width: 100%;" />

        <RadzenButton Text="Зарегистрировать" ButtonStyle="ButtonStyle.Primary" Click="@HandleRegister" Disabled="@isLoading" Style="width: 100%;" />
    </div>
</RadzenCard>

@code {
    private CreateAbonentRequest request = new();
    private bool isLoading;
    private bool showError;
    private string errorMessage = string.Empty;
    private bool showSuccess;
    private string successMessage = string.Empty;

    private async Task HandleRegister()
    {
        if (string.IsNullOrWhiteSpace(request.IdentificationNumber) ||
            string.IsNullOrWhiteSpace(request.LastName) ||
            string.IsNullOrWhiteSpace(request.FirstName) ||
            string.IsNullOrWhiteSpace(request.Email))
        {
            showError = true;
            errorMessage = "Заполните обязательные поля: ИНН, Фамилия, Имя, Email";
            return;
        }

        isLoading = true;
        showError = false;
        showSuccess = false;

        try
        {
            var abonentId = await AbonentRegistrationService.RegisterAbonentAsync(request);

            if (abonentId.HasValue)
            {
                showSuccess = true;
                successMessage = "Абонент успешно зарегистрирован. Данные для входа отправлены на email.";
                request = new CreateAbonentRequest();

                // Navigate to client card after a short delay
                await Task.Delay(1500);
                Navigation.NavigateTo($"/manager/client-card/{abonentId.Value}");
            }
            else
            {
                showError = true;
                errorMessage = "Ошибка при регистрации абонента. Проверьте введенные данные.";
            }
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Ошибка подключения: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
