@inject DialogService DialogService

<RadzenCard Style="min-width: 500px;">
    <RadzenAlert @bind-Visible="@showError" Severity="AlertStyle.Danger" Style="margin-bottom: 12px;">
        @errorMessage
    </RadzenAlert>

    <div style="display: grid; gap: 12px;">
        <div>
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">Фамилия *</label>
            <RadzenTextBox @bind-Value="@LastName" Placeholder="Фамилия" Style="width: 100%;" />
        </div>
        <div>
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">Имя *</label>
            <RadzenTextBox @bind-Value="@FirstName" Placeholder="Имя" Style="width: 100%;" />
        </div>
        <div>
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">Отчество</label>
            <RadzenTextBox @bind-Value="@MiddleName" Placeholder="Отчество" Style="width: 100%;" />
        </div>
        <div>
            <label style="display: block; margin-bottom: 4px; font-weight: 500;">Идентификационный номер *</label>
            <RadzenTextBox @bind-Value="@IdentificationNumber" Placeholder="ИНН" Style="width: 100%;" />
        </div>
        @if (!IsEditMode)
        {
            <div>
                <label style="display: block; margin-bottom: 4px; font-weight: 500;">Email *</label>
                <RadzenTextBox @bind-Value="@Email" Placeholder="Email" Style="width: 100%;" />
                <small style="color: #666;">Необходим для отправки логина и пароля</small>
            </div>
        }
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px;">
        <RadzenButton Text="Отмена" ButtonStyle="ButtonStyle.Secondary" Click="@Close" />
        <RadzenButton Text="@GetSaveButtonText()" ButtonStyle="ButtonStyle.Primary" Click="@Save" />
    </div>
</RadzenCard>

@code {
    [Parameter]
    public bool IsEditMode { get; set; } = true;
    [Parameter]
    public string LastName { get; set; } = string.Empty;
    [Parameter]
    public string FirstName { get; set; } = string.Empty;
    [Parameter]
    public string? MiddleName { get; set; }
    [Parameter]
    public string IdentificationNumber { get; set; } = string.Empty;
    [Parameter]
    public string Email { get; set; } = string.Empty;

    private bool showError;
    private string errorMessage = string.Empty;

    private void Close()
    {
        DialogService.Close(null);
    }

    private async Task Save()
    {
        showError = false;

        if (string.IsNullOrWhiteSpace(LastName) ||
            string.IsNullOrWhiteSpace(FirstName) ||
            string.IsNullOrWhiteSpace(IdentificationNumber))
        {
            showError = true;
            errorMessage = "Заполните обязательные поля";
            return;
        }

        if (!IsEditMode && string.IsNullOrWhiteSpace(Email))
        {
            showError = true;
            errorMessage = "Введите Email для регистрации абонента";
            return;
        }

        if (!IsEditMode && !Email.Contains("@"))
        {
            showError = true;
            errorMessage = "Введите корректный Email";
            return;
        }

        var result = new SharedDialog.EditAbonentDialog.Models.EditAbonentDialogResult
        {
            IsEditMode = IsEditMode,
            LastName = LastName,
            FirstName = FirstName,
            MiddleName = MiddleName,
            IdentificationNumber = IdentificationNumber,
            Email = Email
        };

        DialogService.Close(result);
    }

    private string GetSaveButtonText() => IsEditMode ? "Сохранить" : "Зарегистрировать";
}