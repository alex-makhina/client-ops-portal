@page "/manager/abonents"
@attribute [Authorize(Roles = "Manager")]

@using ClientOpsPortal.Web.Features.AbonentManagement.Models
@using ClientOpsPortal.Web.Features.AbonentManagement.Services
@using ClientOpsPortal.Web.Features.SharedDialog.EditAbonentDialog.Models
@using ClientOpsPortal.Web.Features.SharedDialog.EditAbonentDialog
@using ClientOpsPortal.Web.Features.Shared.Notification

@inject IAbonentManagementService AbonentSearchService
@inject NavigationManager Navigation
@inject DialogService DialogService
@inject AppNotificationService NotificationService

<div class="page-container">
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">Абоненты</h3>
            </div>
            <button class="btn btn-primary" @onclick="OpenRegisterDialog">
                Регистрация абонента
            </button>
        </div>

        <div class="card-body">
            <div class="search-section">
                <div class="search-input-group">
                    <div class="search-input-wrapper">
                        <input type="text"
                               class="form-control"
                               placeholder="Поиск по ФИО..."
                               @bind="searchTerm"
                               @bind:event="oninput" />
                    </div>
                    <button class="btn btn-primary" @onclick="HandleSearch" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span>Поиск...</span>
                        }
                        else
                        {
                            <span>Найти</span>
                        }
                    </button>
                </div>
            </div>

            @if (showError)
            {
                <div class="alert alert-danger">
                    <span>⚠️</span>
                    @errorMessage
                </div>
            }

            @if (searchPerformed && !showError)
            {
                <div class="results-section">
                    @if (results.Count == 0)
                    {
                        <div class="alert alert-warning">
                            <span>ℹ️</span>
                            Абоненты не найдены
                        </div>
                    }
                    else
                    {
                        <div class="results-list">
                            @foreach (var result in results)
                            {
                                <div class="list-item">
                                    <div class="list-item-content">
                                        <div class="list-item-title">@result.FullName</div>
                                        <div class="list-item-subtitle">
                                            Лицевой счет: @result.AccountNumber
                                        </div>
                                    </div>
                                    <div class="list-item-actions">
                                        <button class="btn btn-primary btn-sm"
                                                @onclick="() => NavigateToClientCard(result.Id)">
                                            Открыть карточку
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string searchTerm = string.Empty;
    private bool isLoading;
    private bool showError;
    private string errorMessage = string.Empty;
    private bool searchPerformed;
    private List<AbonentShortResult> results = new();

    private async Task HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            showError = true;
            errorMessage = "Введите поисковый запрос";
            return;
        }

        isLoading = true;
        showError = false;
        searchPerformed = false;

        try
        {
            var searchResults = await AbonentSearchService.SearchByNameAsync(searchTerm);
            results = searchResults.ToList();
            searchPerformed = true;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Ошибка при поиске: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenRegisterDialog()
    {
        var result = await DialogService.OpenAsync<EditAbonentDialog>(
            "Регистрация абонента",
            new Dictionary<string, object?>
            {
                { "IsEditMode", false },
                { "LastName", string.Empty },
                { "FirstName", string.Empty },
                { "MiddleName", string.Empty },
                { "IdentificationNumber", string.Empty },
                { "Email", string.Empty }
            },
            new DialogOptions { Width = "600px", CloseDialogOnOverlayClick = false, Resizable = true, Draggable = true }
        );

        if (result is EditAbonentDialogResult dialogResult && !dialogResult.IsEditMode)
        {
            await HandleRegisterAbonent(dialogResult);
        }
    }

    private async Task HandleRegisterAbonent(EditAbonentDialogResult data)
    {
        var request = new AbonentRequest
        {
            LastName = data.LastName,
            FirstName = data.FirstName,
            MiddleName = data.MiddleName,
            IdentificationNumber = data.IdentificationNumber,
            Email = data.Email
        };

        var abonentId = await AbonentSearchService.RegisterAbonentAsync(request);

        if (abonentId.HasValue)
        {
            NotificationService.ShowSuccess($"Абонент успешно зарегистрирован. Данные для входа отправлены на email.");

            searchTerm = $"{data.LastName} {data.FirstName}";
            await HandleSearch();
        }
        else
        {
            NotificationService.ShowError("Не удалось зарегистрировать абонента. Проверьте введенные данные.");
        }
    }

    private void NavigateToClientCard(Guid abonentId)
    {
        Navigation.NavigateTo($"/manager/client-card/{abonentId}");
    }
}