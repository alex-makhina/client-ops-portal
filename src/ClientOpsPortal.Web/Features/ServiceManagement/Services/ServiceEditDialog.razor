@using ClientOpsPortal.Web.Features.ServiceManagement.Models
@using System.ComponentModel.DataAnnotations
@inject DialogService DialogService

<RadzenCard Style="min-width: 650px; max-width: 800px;">
    <div class="p-3">
        <RadzenAlert @bind-Visible="@showError" Severity="AlertStyle.Danger" Style="margin-bottom: 12px;">
            @errorMessage
        </RadzenAlert>

        <div style="margin-bottom: 24px;">
            <h5>Основная информация</h5>
            <div style="display: grid; grid-template-columns: 1fr; gap: 12px;">
                <div>
                    <label style="display: block; margin-bottom: 4px; font-weight: 500;">
                        Название услуги <span style="color: red;">*</span>
                    </label>
                    <RadzenTextBox @bind-Value="@Name"
                                   Placeholder="Например: Интернет"
                                   Style="width: 100%;"
                                   @oninput="OnNameChanged" />
                    <small style="color: #666; font-size: 12px;">
                        От 3 до 100 символов
                    </small>
                </div>
                <div>
                    <label style="display: block; margin-bottom: 4px; font-weight: 500;">
                        Описание <span style="color: red;">*</span>
                    </label>
                    <RadzenTextArea @bind-Value="@Description"
                                    Placeholder="Описание услуги..."
                                    Rows="3"
                                    Style="width: 100%;"
                                    @oninput="OnDescriptionChanged" />
                    <small style="color: #666; font-size: 12px;">
                        От 10 до 500 символов
                    </small>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div>
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">
                            Дата начала <span style="color: red;">*</span>
                        </label>
                        <RadzenDatePicker @bind-Value="@BeginDate"
                                          Placeholder="дд.мм.гггг"
                                          Style="width: 100%;" />
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 4px; font-weight: 500;">Дата окончания</label>
                        <RadzenDatePicker @bind-Value="@EndDate"
                                          Placeholder="дд.мм.гггг"
                                          Style="width: 100%;" />
                        <small style="color: #666; font-size: 12px;">
                            Оставьте пустым, если услуга бессрочная
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <h5>Тарифные планы</h5>
                <RadzenButton Text=" Добавить тариф"
                              ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Small"
                              Icon="add"
                              Click="@AddTariffPlan" />
            </div>

            @if (IsEditMode)
            {
                if (UpdateTariffPlans.Count == 0)
                {
                    <div style="text-align: center; padding: 30px; color: #666; border: 1px dashed #ccc; border-radius: 8px;">
                        Нет тарифных планов. Нажмите "+ Добавить тариф"
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        @for (int i = 0; i < UpdateTariffPlans.Count; i++)
                        {
                            var tariff = UpdateTariffPlans[i];
                            var index = i;
                            <div style="border: 1px solid #e0e0e0; border-radius: 8px; padding: 16px; background-color: #fafafa; transition: all 0.2s;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                    <strong style="font-size: 14px; color: #333;">
                                        Тарифный план @(i + 1)
                                    </strong>
                                    <RadzenButton Icon="delete"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Size="ButtonSize.Small"
                                                  Click="@(() => RemoveTariffPlan(index))" />
                                </div>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                                    <div>
                                        <label style="display: block; margin-bottom: 4px; font-size: 12px; color: #666;">
                                            Название <span style="color: red;">*</span>
                                        </label>
                                        <RadzenTextBox @bind-Value="@tariff.Name"
                                                       Placeholder="Например: Старт"
                                                       Style="width: 100%;" />
                                    </div>
                                    <div>
                                        <label style="display: block; margin-bottom: 4px; font-size: 12px; color: #666;">
                                            Цена <span style="color: red;">*</span>
                                        </label>
                                        <RadzenNumeric @bind-Value="@tariff.Price"
                                                       Placeholder="0"
                                                       Min="0"
                                                       Format="C2"
                                                       Style="width: 100%;" />
                                    </div>
                                    <div style="grid-column: span 2;">
                                        <label style="display: block; margin-bottom: 4px; font-size: 12px; color: #666;">Описание</label>
                                        <RadzenTextArea @bind-Value="@tariff.Description"
                                                        Placeholder="Описание тарифа"
                                                        Rows="2"
                                                        Style="width: 100%;" />
                                    </div>
                                    <div>
                                        <label style="display: block; margin-bottom: 4px; font-size: 12px; color: #666;">
                                            Дата начала <span style="color: red;">*</span>
                                        </label>
                                        <RadzenDatePicker @bind-Value="@tariff.BeginDate"
                                                          Placeholder="дд.мм.гггг"
                                                          Style="width: 100%;" />
                                    </div>
                                    <div>
                                        <label style="display: block; margin-bottom: 4px; font-size: 12px; color: #666;">Дата окончания</label>
                                        <RadzenDatePicker @bind-Value="@tariff.EndDate"
                                                          Placeholder="дд.мм.гггг"
                                                          Style="width: 100%;" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                if (CreateTariffPlans.Count == 0)
                {
                    <div style="text-align: center; padding: 30px; color: #666; border: 1px dashed #ccc; border-radius: 8px;">
                        Нет тарифных планов. Нажмите "+ Добавить тариф"
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        @for (int i = 0; i < CreateTariffPlans.Count; i++)
                        {
                            var tariff = CreateTariffPlans[i];
                            var index = i;
                            <div style="border: 1px solid #e0e0e0; border-radius: 8px; padding: 16px; background-color: #fafafa; transition: all 0.2s;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                    <strong style="font-size: 14px; color: #333;">
                                        Тарифный план @(i + 1)
                                    </strong>
                                    <RadzenButton Icon="delete"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Size="ButtonSize.Small"
                                                  Click="@(() => RemoveTariffPlan(index))" />
                                </div>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                                    <div>
                                        <label style="display: block; margin-bottom: 4px; font-size: 12px; color: #666;">
                                            Название <span style="color: red;">*</span>
                                        </label>
                                        <RadzenTextBox @bind-Value="@tariff.Name"
                                                       Placeholder="Например: Старт"
                                                       Style="width: 100%;" />
                                    </div>
                                    <div>
                                        <label style="display: block; margin-bottom: 4px; font-size: 12px; color: #666;">
                                            Цена <span style="color: red;">*</span>
                                        </label>
                                        <RadzenNumeric @bind-Value="@tariff.Price"
                                                       Placeholder="0"
                                                       Min="0"
                                                       Format="C2"
                                                       Style="width: 100%;" />
                                    </div>
                                    <div style="grid-column: span 2;">
                                        <label style="display: block; margin-bottom: 4px; font-size: 12px; color: #666;">Описание</label>
                                        <RadzenTextArea @bind-Value="@tariff.Description"
                                                        Placeholder="Описание тарифа"
                                                        Rows="2"
                                                        Style="width: 100%;" />
                                    </div>
                                    <div>
                                        <label style="display: block; margin-bottom: 4px; font-size: 12px; color: #666;">
                                            Дата начала <span style="color: red;">*</span>
                                        </label>
                                        <RadzenDatePicker @bind-Value="@tariff.BeginDate"
                                                          Placeholder="дд.мм.гггг"
                                                          Style="width: 100%;" />
                                    </div>
                                    <div>
                                        <label style="display: block; margin-bottom: 4px; font-size: 12px; color: #666;">Дата окончания</label>
                                        <RadzenDatePicker @bind-Value="@tariff.EndDate"
                                                          Placeholder="дд.мм.гггг"
                                                          Style="width: 100%;" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 24px;">
            <RadzenButton Text="Отмена" ButtonStyle="ButtonStyle.Secondary" Click="@Close" />
            <RadzenButton Text="@GetSaveButtonText()"
                          ButtonStyle="ButtonStyle.Primary"
                          Icon="save"
                          Click="@Save" />
        </div>
    </div>
</RadzenCard>

@code {
    [Parameter]
    public bool IsEditMode { get; set; }
    [Parameter]
    public Guid ServiceId { get; set; }
    [Parameter]
    public string Name { get; set; } = string.Empty;
    [Parameter]
    public string Description { get; set; } = string.Empty;
    [Parameter]
    public DateTimeOffset BeginDate { get; set; } = DateTimeOffset.UtcNow;
    [Parameter]
    public DateTimeOffset? EndDate { get; set; }
    [Parameter]
    public List<CreateTariffPlanFromServiceRequest> CreateTariffPlans { get; set; } = new();
    [Parameter]
    public List<UpdateTariffPlanFromServiceRequest> UpdateTariffPlans { get; set; } = new();

    private bool showError;
    private string errorMessage = string.Empty;
    private int nameLength = 0;
    private int descriptionLength = 0;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (CreateTariffPlans == null) CreateTariffPlans = new();
        if (UpdateTariffPlans == null) UpdateTariffPlans = new();

        nameLength = Name?.Length ?? 0;
        descriptionLength = Description?.Length ?? 0;
    }

    private void OnNameChanged(ChangeEventArgs e)
    {
        nameLength = e.Value?.ToString()?.Length ?? 0;
        StateHasChanged();
    }

    private void OnDescriptionChanged(ChangeEventArgs e)
    {
        descriptionLength = e.Value?.ToString()?.Length ?? 0;
        StateHasChanged();
    }

    private void Close()
    {
        DialogService.Close(null);
    }

    private void AddTariffPlan()
    {
        if (IsEditMode)
        {
            UpdateTariffPlans.Add(new UpdateTariffPlanFromServiceRequest
            {
                Id = Guid.Empty,
                Name = string.Empty,
                Description = string.Empty,
                Price = 0,
                BeginDate = DateTimeOffset.UtcNow,
                EndDate = null
            });
        }
        else
        {
            CreateTariffPlans.Add(new CreateTariffPlanFromServiceRequest
            {
                Name = string.Empty,
                Description = string.Empty,
                Price = 0,
                BeginDate = DateTimeOffset.UtcNow,
                EndDate = null
            });
        }
        StateHasChanged();
    }

    private void RemoveTariffPlan(int index)
    {
        if (IsEditMode)
        {
            UpdateTariffPlans.RemoveAt(index);
        }
        else
        {
            CreateTariffPlans.RemoveAt(index);
        }
        StateHasChanged();
    }

    private string ValidateService()
    {
        if (string.IsNullOrWhiteSpace(Name))
            return "Введите название услуги";

        if (Name.Length < 3 || Name.Length > 100)
            return "Название услуги должно содержать от 3 до 100 символов";

        if (string.IsNullOrWhiteSpace(Description))
            return "Введите описание услуги";

        if (Description.Length < 10 || Description.Length > 500)
            return "Описание услуги должно содержать от 10 до 500 символов";

        if (BeginDate == default)
            return "Укажите дату начала услуги";

        if (EndDate.HasValue && EndDate.Value.ToUniversalTime() <= BeginDate.ToUniversalTime())
            return "Дата окончания должна быть позже даты начала";

        return string.Empty;
    }

    private string ValidateTariffPlan(dynamic tariff, int index)
    {
        if (string.IsNullOrWhiteSpace(tariff.Name))
            return $"Введите название тарифного плана #{index + 1}";

        if (tariff.Name.Length < 3 || tariff.Name.Length > 100)
            return $"Название тарифного плана #{index + 1} должно содержать от 3 до 100 символов";

        if (string.IsNullOrWhiteSpace(tariff.Description))
            return $"Введите описание тарифного плана #{index + 1}";

        if (tariff.Description.Length < 10 || tariff.Description.Length > 500)
            return $"Описание тарифного плана #{index + 1} должно содержать от 10 до 500 символов";

        if (tariff.Price < 0 || tariff.Price > 999)
            return $"Цена тарифного плана #{index + 1} должна быть от 0 до 999";

        DateTimeOffset beginDate = tariff.BeginDate;
        if (beginDate == default)
            return $"Укажите дату начала тарифного плана #{index + 1}";

        if (tariff.EndDate != null)
        {
            DateTimeOffset endDate = tariff.EndDate;
            if (endDate.ToUniversalTime() <= beginDate.ToUniversalTime())
                return $"Дата окончания тарифного плана #{index + 1} должна быть позже даты начала";
        }

        return string.Empty;
    }

    private async Task Save()
    {
        showError = false;

        var serviceError = ValidateService();
        if (!string.IsNullOrEmpty(serviceError))
        {
            showError = true;
            errorMessage = serviceError;
            return;
        }

        var tariffs = IsEditMode ? UpdateTariffPlans.Cast<dynamic>().ToList() : CreateTariffPlans.Cast<dynamic>().ToList();

        for (int i = 0; i < tariffs.Count; i++)
        {
            var tariffError = ValidateTariffPlan(tariffs[i], i);
            if (!string.IsNullOrEmpty(tariffError))
            {
                showError = true;
                errorMessage = tariffError;
                return;
            }
        }

        if (IsEditMode)
        {
            var result = new UpdateServiceRequest
            {
                IsEditMode = true,
                ServiceId = ServiceId,
                Name = Name.Trim(),
                Description = Description.Trim(),
                BeginDate = BeginDate,
                EndDate = EndDate,
                TariffPlans = UpdateTariffPlans.ToList()
            };
            DialogService.Close(result);
        }
        else
        {
            var result = new CreateServiceRequest
            {
                Name = Name.Trim(),
                Description = Description.Trim(),
                BeginDate = BeginDate,
                EndDate = EndDate,
                TariffPlans = CreateTariffPlans.ToList()
            };
            DialogService.Close(result);
        }
    }

    private string GetSaveButtonText() => IsEditMode ? "Сохранить" : "Создать";
}