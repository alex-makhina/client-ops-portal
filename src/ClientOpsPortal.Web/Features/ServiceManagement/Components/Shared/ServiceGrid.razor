@* ServiceGrid.razor *@
@using ClientOpsPortal.Web.Features.ServiceManagement.Models.Responses

@if (Services == null || !Services.Any())
{
    <div style="text-align: center; padding: 60px 20px;">
        <RadzenIcon Icon="inbox" Style="color: #ccc; font-size: 64px;" />
        <p style="color: #999; margin-top: 16px;">@EmptyMessage</p>
        @if (ShowResetButton)
        {
            <RadzenButton Text="Сбросить фильтры" 
                          ButtonStyle="ButtonStyle.Secondary" 
                          Click="OnReset" 
                          Size="ButtonSize.Small" />
        }
    </div>
}
else
{
    <div style="display: grid; grid-template-columns: repeat(2, minmax(350px, 1fr)); gap: 16px;">
        @foreach (var service in Services)
        {
            <ServiceCard Service="service" OnCardClick="OnCardClick" />
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<ServiceListItem>? Services { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = "Услуги не найдены";
    [Parameter] public bool ShowResetButton { get; set; } = false;
    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public EventCallback<ServiceListItem> OnCardClick { get; set; }
}