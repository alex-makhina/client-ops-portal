@* ServiceSearchToolbar.razor *@

<div class="search-toolbar">
    <div class="search-input-wrapper">
        <div class="search-input-container">
            <input type="text"
                   class="search-input"
                   placeholder="Поиск по названию или описанию..."
                   value="@SearchTerm"
                   @oninput="OnSearchInput" />
            @if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                <button class="search-clear" @onclick="ClearSearch">✕</button>
            }
        </div>
    </div>
    <div class="search-actions">
        <div class="filter-container">
            <label class="filter-checkbox">
                <input type="checkbox"
                       checked="@ShowOnlyActive"
                       @onchange="OnShowOnlyActiveChanged" />
                <span>Только активные</span>
            </label>
        </div>
        <button class="btn-create" @onclick="OnCreateClick">
            Создать услугу
        </button>
    </div>
</div>


@code {
    [Parameter] public string SearchTerm { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchTermChanged { get; set; }
    [Parameter] public bool ShowOnlyActive { get; set; }
    [Parameter] public EventCallback<bool> ShowOnlyActiveChanged { get; set; }
    [Parameter] public EventCallback OnCreateClick { get; set; }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        await SearchTermChanged.InvokeAsync(value);
    }

    private async Task OnShowOnlyActiveChanged(ChangeEventArgs e)
    {
        var value = e.Value is true;
        await ShowOnlyActiveChanged.InvokeAsync(value);
    }

    private async Task ClearSearch()
    {
        await SearchTermChanged.InvokeAsync(string.Empty);
    }
}