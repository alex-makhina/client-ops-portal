@* ServiceSearchToolbar.razor *@
<div style="display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 20px;">
    <div style="flex: 1;">
        <div style="position: relative;">
            <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #999; font-size: 18px;">🔍</span>
            <input type="text"
                   placeholder="Поиск по названию или описанию..."
                   value="@SearchTerm"
                   @oninput="OnSearchInput"
                   style="width: 100%; padding: 12px 16px 12px 44px; border-radius: 10px; border: 1px solid #e0e0e0; font-size: 14px; outline: none; background-color: #fafafa; height: 40px;" />
        </div>
    </div>
    <div style="display: flex; align-items: center; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 12px; background-color: #f8f9fa; padding: 0 16px; border-radius: 10px; height: 40px;">
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                <input type="checkbox"
                       checked="@ShowOnlyActive"
                       @onchange="OnShowOnlyActiveChanged"
                       style="width: 18px; height: 18px; cursor: pointer; accent-color: #1b6ec2;" />
                <span style="color: #333; font-size: 14px; font-weight: 500;">Только активные</span>
            </label>
        </div>
        <RadzenButton Text="Создать услугу"
                      ButtonStyle="ButtonStyle.Primary"
                      Icon="add"
                      Click="OnCreateClick"
                      Style="border-radius: 10px; padding: 0 20px; height: 40px;" />
    </div>
</div>

@code {
    [Parameter] public string SearchTerm { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchTermChanged { get; set; }
    [Parameter] public bool ShowOnlyActive { get; set; }
    [Parameter] public EventCallback<bool> ShowOnlyActiveChanged { get; set; }
    [Parameter] public EventCallback OnCreateClick { get; set; }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        await SearchTermChanged.InvokeAsync(value);
    }

    private async Task OnShowOnlyActiveChanged(ChangeEventArgs e)
    {
        var value = e.Value is true;
        await ShowOnlyActiveChanged.InvokeAsync(value);
    }
}