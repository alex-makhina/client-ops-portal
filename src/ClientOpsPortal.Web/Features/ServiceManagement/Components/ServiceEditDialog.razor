@* ServiceEditDialog.razor *@
@using ClientOpsPortal.Web.Features.ServiceManagement.Models.Requests
@using ClientOpsPortal.Web.Features.ServiceManagement.Validators
@inject DialogService DialogService
@inject IJSRuntime JSRuntime

<div class="modal-overlay" id="service-dialog-overlay">
    <div class="modal-content" id="modal-content">
        <div class="modal-header">
            <div class="modal-header-left">
                <h3>@(IsEditMode ? "Редактирование услуги" : "Создание услуги")</h3>
            </div>
            <button class="modal-close" type="button" @onclick="Close">×</button>
        </div>

        <div class="modal-body" id="modal-body">
            @if (showError)
            {
                <div class="alert alert-danger">
                    <span class="alert-icon">⚠️</span>
                    <span>@errorMessage</span>
                </div>
            }

            <div class="section">
                <div class="section-header">
                    <h4 class="section-title">Основная информация</h4>
                    <span class="section-badge">Обязательные поля *</span>
                </div>
                <div class="form-grid">
                    <div class="form-group form-group-full">
                        <label class="form-label">
                            Название услуги
                            <span class="required">*</span>
                        </label>
                        <input type="text"
                               class="form-input"
                               placeholder="Введите название услуги"
                               value="@serviceName"
                               @onchange="(e) => serviceName = e.Value?.ToString() ?? string.Empty"
                               @oninput="(e) => serviceName = e.Value?.ToString() ?? string.Empty" />
                        <span class="form-hint">
                            <span class="hint-icon"></span>
                            От 3 до 100 символов
                        </span>
                    </div>

                    <div class="form-group form-group-full">
                        <label class="form-label">
                            Описание
                            <span class="required">*</span>
                        </label>
                        <textarea class="form-textarea"
                                  placeholder="Введите описание услуги"
                                  rows="2"
                                  value="@serviceDescription"
                                  @onchange="(e) => serviceDescription = e.Value?.ToString() ?? string.Empty"
                                  @oninput="(e) => serviceDescription = e.Value?.ToString() ?? string.Empty"></textarea>
                        <span class="form-hint">
                            <span class="hint-icon"></span>
                            От 10 до 500 символов
                        </span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            Дата начала
                            <span class="required">*</span>
                        </label>
                        <RadzenDatePicker @bind-Value="serviceBeginDate"
                                          Placeholder="Выберите дату"
                                          ShowIcon="true"
                                          Style="width:100%;" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Дата окончания</label>
                        <RadzenDatePicker @bind-Value="serviceEndDate"
                                          Placeholder="Не ограничено"
                                          ShowIcon="true"
                                          Style="width:100%;" />
                        <span class="form-hint">
                            <span class="hint-icon"></span>
                            Оставьте пустым, если услуга бессрочная
                        </span>
                    </div>
                </div>
            </div>

            <div class="section">
                <div class="section-header">
                    <h4 class="section-title">Тарифные планы</h4>
                    <button class="btn-add-tariff" @onclick="AddTariffPlan">
                        ➕ Добавить тариф
                    </button>
                </div>

                @if (tariffPlansList.Count == 0)
                {
                    <div class="empty-state">
                        <div class="empty-state-icon">📋</div>
                        <p class="empty-state-title">Нет тарифных планов</p>
                        <p class="empty-state-description">Нажмите кнопку "Добавить тариф", чтобы создать первый тарифный план</p>
                    </div>
                }
                else
                {
                    <div class="tariff-list">
                        @for (int i = 0; i < tariffPlansList.Count; i++)
                        {
                            var index = i;
                            var tariff = tariffPlansList[index];
                            <div class="tariff-card" @key="tariff.Id">
                                <div class="tariff-header">
                                    <div class="tariff-header-left">
                                        <span class="tariff-number">#@(index + 1)</span>
                                        <strong class="tariff-title">Тарифный план</strong>
                                    </div>
                                    <button class="btn-delete-tariff" @onclick="() => RemoveTariffPlan(index)">
                                        <span class="delete-icon">🗑️</span>
                                    </button>
                                </div>
                                <div class="tariff-body">
                                    <div class="form-group">
                                        <label class="form-label">
                                            Название
                                            <span class="required">*</span>
                                        </label>
                                        <input type="text"
                                               class="form-input form-input-sm"
                                               placeholder="Например: Базовый"
                                               value="@tariff.Name"
                                               @onchange="(e) => OnTariffNameChange(index, e)"
                                               @oninput="(e) => OnTariffNameChange(index, e)" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">
                                            Цена
                                            <span class="required">*</span>
                                        </label>
                                        <div class="price-input-wrapper">
                                            <span class="price-currency">₽</span>
                                            <input type="number"
                                                   class="price-input price-input-sm"
                                                   min="0"
                                                   step="0.01"
                                                   placeholder="0"
                                                   value="@tariff.Price"
                                                   @onchange="(e) => OnPriceChange(index, e)"
                                                   @oninput="(e) => OnPriceInput(index, e)" />
                                        </div>
                                    </div>
                                    <div class="form-group form-group-full">
                                        <label class="form-label">Описание</label>
                                        <input type="text"
                                               class="form-input form-input-sm"
                                               placeholder="Описание тарифного плана"
                                               value="@tariff.Description"
                                               @onchange="(e) => OnTariffDescriptionChange(index, e)"
                                               @oninput="(e) => OnTariffDescriptionChange(index, e)" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">
                                            Дата начала
                                            <span class="required">*</span>
                                        </label>
                                        <RadzenDatePicker @bind-Value="tariff.BeginDate"
                                                          Placeholder="Выберите дату"
                                                          ShowIcon="true"
                                                          Style="width:100%;" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Дата окончания</label>
                                        <RadzenDatePicker @bind-Value="tariff.EndDate"
                                                          Placeholder="Не ограничено"
                                                          ShowIcon="true"
                                                          Style="width:100%;" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="modal-footer">
            <button class="btn-cancel" @onclick="Close">Отмена</button>
            <button class="btn-save" @onclick="Save">
                <span class="save-icon"></span>
                @GetSaveButtonText()
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public Guid ServiceId { get; set; }
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public DateTimeOffset BeginDate { get; set; } = DateTimeOffset.UtcNow;
    [Parameter] public DateTimeOffset? EndDate { get; set; }
    [Parameter] public List<TariffPlanRequest> TariffPlans { get; set; } = new();

    private string serviceName = string.Empty;
    private string serviceDescription = string.Empty;
    private DateTimeOffset serviceBeginDate = DateTimeOffset.UtcNow;
    private DateTimeOffset? serviceEndDate;
    private List<TariffPlanRequest> tariffPlansList = new();

    private bool showError;
    private string errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        serviceName = Name;
        serviceDescription = Description;
        serviceBeginDate = BeginDate;
        serviceEndDate = EndDate;
        tariffPlansList = TariffPlans?.ToList() ?? new List<TariffPlanRequest>();
    }

    private void OnTariffNameChange(int index, ChangeEventArgs e)
    {
        if (index >= 0 && index < tariffPlansList.Count)
        {
            tariffPlansList[index].Name = e.Value?.ToString() ?? string.Empty;
        }
    }

    private void OnTariffDescriptionChange(int index, ChangeEventArgs e)
    {
        if (index >= 0 && index < tariffPlansList.Count)
        {
            tariffPlansList[index].Description = e.Value?.ToString() ?? string.Empty;
        }
    }

    private void OnPriceChange(int index, ChangeEventArgs e)
    {
        if (index >= 0 && index < tariffPlansList.Count)
        {
            var value = e.Value?.ToString();
            if (decimal.TryParse(value, out decimal result))
            {
                tariffPlansList[index].Price = result;
            }
            else if (string.IsNullOrEmpty(value))
            {
                tariffPlansList[index].Price = 0;
            }
        }
    }

    private void OnPriceInput(int index, ChangeEventArgs e)
    {
        if (index >= 0 && index < tariffPlansList.Count)
        {
            var value = e.Value?.ToString();
            if (decimal.TryParse(value, out decimal result))
            {
                tariffPlansList[index].Price = result;
            }
        }
    }

    private void Close() => DialogService.Close(null);

    private void AddTariffPlan()
    {
        tariffPlansList.Add(new TariffPlanRequest
        {
            Id = Guid.Empty,
            Name = string.Empty,
            Description = string.Empty,
            Price = 0,
            ServiceId = ServiceId,
            BeginDate = DateTimeOffset.UtcNow,
            EndDate = null
        });
        
        StateHasChanged();
    }

    private void RemoveTariffPlan(int index)
    {
        if (index >= 0 && index < tariffPlansList.Count)
        {
            tariffPlansList.RemoveAt(index);
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        showError = false;

        var serviceError = ServiceTariffValidator.ValidateService(serviceName, serviceDescription, serviceBeginDate, serviceEndDate);
        if (serviceError != null)
        {
            showError = true;
            errorMessage = serviceError;
            return;
        }

        for (int i = 0; i < tariffPlansList.Count; i++)
        {
            var tariffError = ServiceTariffValidator.ValidateTariffPlan(tariffPlansList[i], i);
            if (tariffError != null)
            {
                showError = true;
                errorMessage = tariffError;
                return;
            }
        }

        if (IsEditMode)
        {
            var result = new UpdateServiceRequest
            {
                IsEditMode = true,
                ServiceId = ServiceId,
                Name = serviceName.Trim(),
                Description = serviceDescription.Trim(),
                BeginDate = serviceBeginDate,
                EndDate = serviceEndDate,
                TariffPlans = tariffPlansList.ToList()
            };
            DialogService.Close(result);
        }
        else
        {
            var result = new CreateServiceRequest
            {
                Name = serviceName.Trim(),
                Description = serviceDescription.Trim(),
                BeginDate = serviceBeginDate,
                EndDate = serviceEndDate,
                TariffPlans = tariffPlansList.ToList()
            };
            DialogService.Close(result);
        }
    }

    private string GetSaveButtonText() => IsEditMode ? "Сохранить" : "Создать";
}