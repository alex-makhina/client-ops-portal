@using ClientOpsPortal.Web.Features.Reports.Models
@using ClientOpsPortal.Web.Features.Reports.Services
@using ClientOpsPortal.Web.Features.Reports.Components.Shared

@inject IReportService ReportService
@inject DialogService DialogService

<div class="report-section">
    <div class="report-header">
        <h4>Динамика подписок</h4>
        <ExportButton ExportFunction="ExportReportData"
                      FileName="subscriptions-dynamics.csv"
                      SuccessMessage="Отчет успешно экспортирован"
                      ErrorMessage="Не удалось экспортировать отчет" />
    </div>

    <div class="filters">
        <div class="filter-group">
            <label>Период с</label>
            <input type="date"
                   class="filter-input"
                   value="@dateFrom.ToString("yyyy-MM-dd")"
                   @onchange="OnDateFromChanged" />
        </div>
        <div class="filter-group">
            <label>по</label>
            <input type="date"
                   class="filter-input"
                   value="@dateTo.ToString("yyyy-MM-dd")"
                   @onchange="OnDateToChanged" />
        </div>
        <div class="filter-group">
            <label>Группировка</label>
            <select class="filter-input" @bind="groupBy">
                <option value="Day">По дням</option>
                <option value="Week">По неделям</option>
                <option value="Month">По месяцам</option>
            </select>
        </div>
        <button class="btn btn-primary btn-sm" @onclick="ApplyFilters">Применить</button>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="loading-spinner"></div>
            <p>Загрузка данных...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger">
            <span>⚠️</span>
            @errorMessage
        </div>
    }
    else if (data == null)
    {
        <div class="empty-state">
            <p>Нет данных для отображения</p>
        </div>
    }
    else
    {
        <div class="stats-grid">
            <div class="stat-card">
                <span class="stat-value">@data.NewSubscriptions</span>
                <span class="stat-label">Новых подписок</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@data.ClosedSubscriptions</span>
                <span class="stat-label">Закрытых подписок</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@data.TotalRevenue.ToString("C0")</span>
                <span class="stat-label">Общая выручка</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@data.UniqueAbonents</span>
                <span class="stat-label">Уникальных абонентов</span>
            </div>
        </div>

        <div class="chart-section">
            <h5>Распределение по услугам</h5>
            <div class="chart-bars">
                @foreach (var item in data.SubscriptionsByService)
                {
                    var maxValue = data.SubscriptionsByService.Values.Max();
                    var percent = maxValue > 0 ? (int)((double)item.Value / maxValue * 100) : 0;
                    <div class="chart-bar">
                        <span class="chart-label">@item.Key</span>
                        <div class="chart-track">
                            <div class="chart-fill" style="width: @percent%; background: @GetColor(item.Key);"></div>
                        </div>
                        <span class="chart-value">@item.Value</span>
                    </div>
                }
            </div>
        </div>

        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Период</span>
                <span class="info-value">@data.PeriodStart.ToString("dd.MM.yyyy") - @data.PeriodEnd.ToString("dd.MM.yyyy")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Изменение количества подписок</span>
                <span class="info-value @(data.NewSubscriptions - data.ClosedSubscriptions >= 0 ? "positive" : "negative")">
                    @(data.NewSubscriptions - data.ClosedSubscriptions >= 0 ? "+" : "")@(data.NewSubscriptions - data.ClosedSubscriptions)
                </span>
            </div>
        </div>
    }
</div>

@code {
    private SubscriptionDynamicsReportItem? data;
    private bool isLoading = true;
    private string? errorMessage;
    private DateTime dateFrom = DateTime.Now.AddMonths(-1);
    private DateTime dateTo = DateTime.Now;
    private string groupBy = "Day";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private void OnDateFromChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (DateTime.TryParse(value, out var date))
        {
            dateFrom = date;
        }
    }

    private void OnDateToChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (DateTime.TryParse(value, out var date))
        {
            dateTo = date;
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var filter = new ReportFilterModel
            {
                DateFrom = new DateTimeOffset(dateFrom.Year, dateFrom.Month, dateFrom.Day, 0, 0, 0, TimeSpan.FromHours(3)),
                DateTo = new DateTimeOffset(dateTo.Year, dateTo.Month, dateTo.Day, 23, 59, 59, TimeSpan.FromHours(3)),
                GroupBy = groupBy
            };
            data = await ReportService.GetSubscriptionsDynamicsAsync(filter);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilters()
    {
        await LoadData();
    }

    private async Task<byte[]> ExportReportData()
    {
        var filter = new ReportFilterModel
        {
            DateFrom = new DateTimeOffset(dateFrom.Year, dateFrom.Month, dateFrom.Day, 0, 0, 0, TimeSpan.FromHours(3)),
            DateTo = new DateTimeOffset(dateTo.Year, dateTo.Month, dateTo.Day, 23, 59, 59, TimeSpan.FromHours(3)),
            GroupBy = groupBy
        };
        return await ReportService.ExportReportAsync("subscriptions-dynamics", filter);
    }

    private string GetColor(string key)
    {
        var colors = new[] { "#1b6ec2", "#28a745", "#ffc107", "#dc3545", "#17a2b8", "#6f42c1" };
        var hash = key.GetHashCode();
        return colors[Math.Abs(hash) % colors.Length];
    }
}