@page "/reports"
@attribute [Authorize(Roles = "DataAnalyst")]

@using ClientOpsPortal.Web.Features.Reports.Models
@using ClientOpsPortal.Web.Features.Reports.Services
@using ClientOpsPortal.Web.Features.Reports.Components

@inject IReportService ReportService
@inject NavigationManager Navigation
@inject DialogService DialogService

<div class="page-container">
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">Отчеты</h3>
                <p class="card-subtitle">Аналитика и отчетность по услугам и подпискам</p>
            </div>
        </div>

        <div class="card-body">
            <div class="tabs">
                <button class="tab @(activeTab == "services" ? "active" : "")" @onclick="SetServicesTab">Статус услуг</button>
                <button class="tab @(activeTab == "subscriptions" ? "active" : "")" @onclick="SetSubscriptionsTab">Активные подписки</button>
                <button class="tab @(activeTab == "dynamics" ? "active" : "")" @onclick="SetDynamicsTab">Динамика подписок</button>
            </div>

            <div class="tab-content">
                @switch (activeTab)
                {
                    case "services":
                        <ServiceStatusReport />
                        break;
                    case "subscriptions":
                        <ActiveSubscriptionsReport />
                        break;
                    case "dynamics":
                        <SubscriptionDynamicsReport />
                        break;
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string activeTab = "services";

    private void SetServicesTab() => SetActiveTab("services");
    private void SetSubscriptionsTab() => SetActiveTab("subscriptions");
    private void SetDynamicsTab() => SetActiveTab("dynamics");

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        StateHasChanged();
    }
}