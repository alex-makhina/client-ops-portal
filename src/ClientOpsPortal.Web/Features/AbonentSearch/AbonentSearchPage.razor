@page "/manager/search-abonent"
@attribute [Authorize(Roles = "Manager")]

@using ClientOpsPortal.Web.Features.AbonentSearch.Models
@using ClientOpsPortal.Web.Features.AbonentSearch.Services

@inject IAbonentSearchService AbonentSearchService
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<RadzenCard Style="max-width: 800px; margin: 20px auto;">
    <h3 class="mb-0">🔍 Поиск абонента</h3>
    <div class="p-3">
        <div style="display: flex; gap: 12px; align-items: center;">
            <RadzenTextBox @bind-Value="@searchTerm" Placeholder="Поиск по ФИО..." Style="flex: 1;" />
            <RadzenButton Text="Найти" ButtonStyle="ButtonStyle.Primary" Click="@HandleSearch" Disabled="@isLoading" />
        </div>

        @if (showError)
        {
            <RadzenAlert Severity="AlertStyle.Danger" Style="margin-top: 16px;">
                @errorMessage
            </RadzenAlert>
        }

        @if (searchPerformed && !showError)
        {
            <div style="margin-top: 20px;">
                @if (results.Count == 0)
                {
                    <RadzenAlert Severity="AlertStyle.Warning">
                        Абоненты не найдены
                    </RadzenAlert>
                }
                else
                {
                    <div Style="margin-top: 12px;">
                        @foreach (var result in results)
                        {
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px; margin-bottom: 8px; background: white; border-radius: 12px; border: 1px solid #e2e8f0;">
                                <div>
                                    <strong>@result.FullName</strong>
                                    <br />
                                    <small style="color: #64748b;">Лицевой счет: @result.AccountNumber</small>
                                </div>
                                <RadzenButton Text="Открыть карточку" ButtonStyle="ButtonStyle.Primary"
                                              Click="@(() => NavigateToClientCard(result.Id))" />
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</RadzenCard>

@code {
    private string searchTerm = string.Empty;
    private bool isLoading;
    private bool showError;
    private string errorMessage = string.Empty;
    private bool searchPerformed;
    private List<AbonentSearchResult> results = new();

    private async Task HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            showError = true;
            errorMessage = "Введите поисковый запрос";
            return;
        }

        isLoading = true;
        showError = false;
        searchPerformed = false;

        try
        {
            var searchResults = await AbonentSearchService.SearchByNameAsync(searchTerm);
            results = searchResults.ToList();
            searchPerformed = true;
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Ошибка при поиске: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToClientCard(Guid abonentId)
    {
        Navigation.NavigateTo($"/manager/client-card/{abonentId}");
    }
}
