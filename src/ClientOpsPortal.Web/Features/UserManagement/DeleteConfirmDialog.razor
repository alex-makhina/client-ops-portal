@inject DialogService DialogService

<RadzenCard Style="min-width: 400px;">
    <h4 class="mb-0">Подтверждение удаления</h4>
    <div class="p-3">
        <p>@GetDeleteConfirmationMessage()</p>
        <div style="display: flex; justify-content: flex-end; gap: 8px;">
            <RadzenButton Text="Отмена" ButtonStyle="ButtonStyle.Secondary" Click="@Cancel" />
            <RadzenButton Text="Удалить" ButtonStyle="ButtonStyle.Danger" Click="@Confirm" Disabled="@isDeleting" />
        </div>
    </div>
</RadzenCard>

@code {
    [Parameter]
    public string UserName { get; set; } = string.Empty;

    private bool isDeleting;

    private void Cancel()
    {
        DialogService.Close(false);
    }

    private async Task Confirm()
    {
        isDeleting = true;
        await Task.Delay(100);
        DialogService.Close(true);
    }

    private string GetDeleteConfirmationMessage()
        => $"Вы уверены, что хотите удалить пользователя \"{UserName}\"?";
}
