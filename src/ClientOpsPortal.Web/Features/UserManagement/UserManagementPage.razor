@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]

@using ClientOpsPortal.Web.Features.UserManagement.Models
@using ClientOpsPortal.Web.Features.UserManagement.Services

@inject IUserManagementService UserManagementService
@inject NavigationManager Navigation
@inject DialogService DialogService

<div class="page-container">
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">Управление пользователями</h3>
                <p class="card-subtitle">Управление учетными записями сотрудников</p>
            </div>
            <button class="btn btn-primary" type="button" @onclick="OpenCreateDialog">
                Создать пользователя
            </button>
        </div>

        <div class="card-body">
            <!-- Поиск -->
            <div class="search-section">
                <div class="search-input-group">
                    <div class="search-input-wrapper">
                        <input type="text"
                               class="form-control search-input"
                               placeholder="Поиск по ФИО, email, логину, должности..."
                               value="@searchTerm"
                               @oninput="OnSearchInput" />
                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <button class="search-clear" type="button" @onclick="ClearSearch">×</button>
                        }
                    </div>
                    <div class="search-filters">
                        <label class="filter-checkbox">
                            <input type="checkbox"
                                   checked="@showOnlyActive"
                                   @onchange="OnShowOnlyActiveChanged" />
                            <span>Только активные</span>
                        </label>
                    </div>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="loading-container">
                    <div class="loading-spinner"></div>
                    <p>Загрузка пользователей...</p>
                </div>
            }
            else
            {
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Таб. номер</th>
                                <th>ФИО</th>
                                <th>Должность</th>
                                <th>Отдел</th>
                                <th>Email</th>
                                <th>Логин</th>
                                <th>Роль</th>
                                <th>Статус</th>
                                <th style="text-align: center;">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (filteredUsers.Count == 0)
                            {
                                <tr>
                                    <td colspan="9" class="empty-state">
                                        <span class="empty-icon"></span>
                                        <p>@GetEmptyMessage()</p>
                                        @if (!string.IsNullOrWhiteSpace(searchTerm) || showOnlyActive)
                                        {
                                            <button class="btn btn-secondary btn-sm" type="button" @onclick="ClearFilters">
                                                Сбросить фильтры
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-primary btn-sm" type="button" @onclick="OpenCreateDialog">
                                                Создать первого пользователя
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var user in filteredUsers)
                                {
                                    <tr>
                                        <td><span class="badge badge-secondary">@user.StaffNumber</span></td>
                                        <td><strong>@user.FullName</strong></td>
                                        <td>@user.Post</td>
                                        <td>@(user.Department ?? "—")</td>
                                        <td><a href="mailto:@user.Email" class="email-link">@user.Email</a></td>
                                        <td><code class="login-code">@user.Login</code></td>
                                        <td><span class="badge badge-info">@user.Role</span></td>
                                        <td>
                                            <span class="badge @(user.IsActive ? "badge-success" : "badge-danger")">
                                                @(user.IsActive ? "Активен" : "Заблокирован")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="action-buttons">
                                                <button class="btn-icon-only btn-edit" type="button"
                                                        @onclick="() => OpenEditDialog(user)"
                                                        title="Редактировать">
                                                    ✏️
                                                </button>
                                                <button class="btn-icon-only @(user.IsActive ? "btn-block" : "btn-unblock")" type="button"
                                                        @onclick="() => ToggleStatus(user)"
                                                        title="@(user.IsActive ? "Заблокировать" : "Разблокировать")">
                                                    @(user.IsActive ? "🔒" : "🔓")
                                                </button>
                                                <button class="btn-icon-only btn-delete" type="button"
                                                        @onclick="() => ConfirmDelete(user)"
                                                        title="Удалить">
                                                    🗑️
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    @if (filteredUsers.Count > 0)
                    {
                        <div class="table-footer">
                            <span class="table-info">
                                Найдено: <strong>@filteredUsers.Count</strong> пользователей
                            </span>
                            <span class="table-info">
                                Активных: <strong class="text-success">@filteredUsers.Count(u => u.IsActive)</strong>
                            </span>
                            <span class="table-info">
                                Заблокированных: <strong class="text-danger">@filteredUsers.Count(u => !u.IsActive)</strong>
                            </span>
                            @if (!string.IsNullOrWhiteSpace(searchTerm) || showOnlyActive)
                            {
                                <button class="btn btn-secondary btn-sm" type="button" @onclick="ClearFilters">
                                    Сбросить фильтры
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<UserListItem> allUsers = new();
    private List<UserListItem> filteredUsers = new();
    private List<string> availableRoles = new();
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private bool showOnlyActive = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            allUsers = await UserManagementService.GetAllUsersAsync();
            availableRoles = await UserManagementService.GetAvailableRolesAsync();
            FilterUsers();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void FilterUsers()
    {
        var query = allUsers.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim().ToLower();
            query = query.Where(u =>
                u.FullName.ToLower().Contains(term) ||
                u.Email.ToLower().Contains(term) ||
                u.Login.ToLower().Contains(term) ||
                u.Post.ToLower().Contains(term) ||
                (u.Department != null && u.Department.ToLower().Contains(term)) ||
                u.StaffNumber.ToLower().Contains(term) ||
                u.Role.ToLower().Contains(term)
            );
        }

        if (showOnlyActive)
        {
            query = query.Where(u => u.IsActive);
        }

        filteredUsers = query.ToList();
        StateHasChanged();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        FilterUsers();
    }

    private void OnShowOnlyActiveChanged(ChangeEventArgs e)
    {
        showOnlyActive = e.Value is true;
        FilterUsers();
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        FilterUsers();
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        showOnlyActive = false;
        FilterUsers();
    }

    private string GetEmptyMessage()
    {
        if (!string.IsNullOrWhiteSpace(searchTerm))
            return $"Пользователи по запросу \"{searchTerm}\" не найдены";
        if (showOnlyActive)
            return "Нет активных пользователей";
        return "Пользователи не найдены";
    }

    private async Task OpenCreateDialog()
    {
        var result = await DialogService.OpenAsync<UserEditDialog>(
            "Создание пользователя",
            new Dictionary<string, object?>
            {
                { "IsEditMode", false },
                { "AvailableRoles", availableRoles }
            },
            new DialogOptions
            {
                Width = "600px",
                CloseDialogOnOverlayClick = false,
                Resizable = true,
                Draggable = true
            }
        );

        if (result is UserEditDialogResult dialogResult)
        {
            await HandleUserSave(dialogResult);
        }
    }

    private async Task OpenEditDialog(UserListItem item)
    {
        var nameParts = item.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        var result = await DialogService.OpenAsync<UserEditDialog>(
            "Редактирование пользователя",
            new Dictionary<string, object?>
            {
                { "IsEditMode", true },
                { "EmployeeId", item.EmployeeId },
                { "StaffNumber", item.StaffNumber },
                { "LastName", nameParts.Length > 0 ? nameParts[0] : string.Empty },
                { "FirstName", nameParts.Length > 1 ? nameParts[1] : string.Empty },
                { "MiddleName", nameParts.Length > 2 ? nameParts[2] : null },
                { "Post", item.Post },
                { "Department", item.Department },
                { "Email", item.Email },
                { "Login", item.Login },
                { "Role", item.Role },
                { "AvailableRoles", availableRoles }
            },
            new DialogOptions
            {
                Width = "600px",
                CloseDialogOnOverlayClick = false,
                Resizable = true,
                Draggable = true
            }
        );

        if (result is UserEditDialogResult dialogResult)
        {
            await HandleUserSave(dialogResult);
        }
    }

    private async Task HandleUserSave(UserEditDialogResult data)
    {
        try
        {
            bool success;
            if (data.IsEditMode)
            {
                var request = new UpdateUserRequest
                {
                    StaffNumber = data.StaffNumber,
                    FirstName = data.FirstName,
                    LastName = data.LastName,
                    MiddleName = data.MiddleName,
                    Post = data.Post,
                    Department = data.Department,
                    Role = data.Role
                };
                success = await UserManagementService.UpdateUserAsync(data.EmployeeId, request);
            }
            else
            {
                var request = new CreateUserRequest
                {
                    StaffNumber = data.StaffNumber,
                    FirstName = data.FirstName,
                    LastName = data.LastName,
                    MiddleName = data.MiddleName,
                    Post = data.Post,
                    Department = data.Department,
                    Email = data.Email,
                    Login = data.Login,
                    Password = data.Password,
                    Role = data.Role
                };
                success = await UserManagementService.CreateUserAsync(request);
            }

            if (success)
            {
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error saving user: {ex.Message}");
        }
    }

    private async Task ToggleStatus(UserListItem item)
    {
        var success = await UserManagementService.ToggleUserStatusAsync(item.EmployeeId);
        if (success)
        {
            await LoadData();
        }     
    }

    private async Task ConfirmDelete(UserListItem item)
    {
        var confirmed = await DialogService.OpenAsync<DeleteConfirmDialog>(
            "Подтверждение удаления",
            new Dictionary<string, object?>
            {
                { "UserName", item.FullName }
            },
            new DialogOptions
            {
                Width = "450px",
                CloseDialogOnOverlayClick = false,
                Resizable = true,
                Draggable = true
            }
        );

        if (confirmed is bool isConfirmed && isConfirmed)
        {
            await DeleteUser(item);
        }
    }

    private async Task DeleteUser(UserListItem item)
    {
        try
        {
            var success = await UserManagementService.DeleteUserAsync(item.EmployeeId);
            if (success)
            {
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error deleting user: {ex.Message}");
        }
    }
}