@page "/set-password"

@inject IAuthService AuthService

@using System.Web
@using System.Net.Http.Json

@inject HttpClient Http
@inject NavigationManager Navigation
@inject NotificationService NotificationService

<RadzenCard Style="max-width: 450px; margin: 100px auto;">
    <h3 class="mb-0">Установка пароля</h3>
    <div class="p-3">
        <RadzenAlert @bind-Visible="@showError" Severity="AlertStyle.Danger" Style="margin-bottom: 16px;">
            @errorMessage
        </RadzenAlert>
        <RadzenAlert @bind-Visible="@showSuccess" Severity="AlertStyle.Success" Style="margin-bottom: 16px;">
            @successMessage
        </RadzenAlert>

        <RadzenPassword @bind-Value="@newPassword" Placeholder="Новый пароль" Style="margin-bottom: 12px; width: 100%;" />
        <RadzenPassword @bind-Value="@confirmPassword" Placeholder="Подтвердите пароль" Style="margin-bottom: 20px; width: 100%;" />

        <RadzenButton Text="Установить пароль" ButtonStyle="ButtonStyle.Primary" Click="@HandleSetPassword" Disabled="@isLoading" Style="width: 100%;" />
    </div>
</RadzenCard>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? UserId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private bool isLoading;
    private bool showError;
    private string errorMessage = string.Empty;
    private bool showSuccess;
    private string successMessage = string.Empty;

    private async Task HandleSetPassword()
    {
        if (string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            showError = true;
            errorMessage = "Введите пароль и подтверждение";
            return;
        }

        if (newPassword != confirmPassword)
        {
            showError = true;
            errorMessage = "Пароли не совпадают";
            return;
        }

        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Token))
        {
            showError = true;
            errorMessage = "Недействительная ссылка для установки пароля";
            return;
        }

        isLoading = true;
        showError = false;
        showSuccess = false;

        try
        {

            var response = await AuthService.SetPassword(Guid.Parse(UserId), Token, newPassword);

            if (response.IsSuccessStatusCode)
            {
                showSuccess = true;
                successMessage = "Пароль успешно установлен. Теперь вы можете войти в систему.";
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                showError = true;
                errorMessage = $"Ошибка: {errorBody}";
            }
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Ошибка подключения: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
