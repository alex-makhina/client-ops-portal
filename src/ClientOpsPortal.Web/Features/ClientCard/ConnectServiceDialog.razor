@using ClientOpsPortal.Web.Features.ClientCard.Models
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject DialogService DialogService
@inject NotificationService NotificationService

<RadzenCard Style="padding: 24px;">
    <h4 style="margin-top: 0; margin-bottom: 20px;">🔌 Подключение услуги</h4>

    <div class="form-group" style="margin-bottom: 16px;">
        <label><strong>Услуга *</strong></label>
        <select class="form-control" value="@selectedServiceId" @onchange="OnServiceChanged"
                style="width: 100%; padding: 8px 12px; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 4px;">
            <option value="@Guid.Empty">Выберите услугу...</option>
            @foreach (var service in services)
            {
                <option value="@service.Id">@service.Name</option>
            }
        </select>
    </div>

    @if (isLoadingTariffs)
    {
        <div style="text-align: center; padding: 16px; color: #64748b;">Загрузка тарифов...</div>
    }
    else if (tariffPlans.Count > 0)
    {
        <div class="form-group" style="margin-bottom: 16px;">
            <label><strong>Тарифный план *</strong></label>
            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 8px;">
                @foreach (var tariff in tariffPlans)
                {
                    <label style="display: flex; align-items: center; gap: 8px; padding: 10px 12px; border: 1px solid @(selectedTariffPlanId == tariff.Id ? "#2563eb" : "#e2e8f0"); border-radius: 8px; cursor: pointer; background: @(selectedTariffPlanId == tariff.Id ? "#eff6ff" : "white");"
                           @onclick="() => SelectTariff(tariff.Id)">
                        <input type="radio" name="tariff" value="@tariff.Id"
                               checked="@(selectedTariffPlanId == tariff.Id)"
                               @onchange="() => SelectTariff(tariff.Id)" />
                        <div>
                            <div><strong>@tariff.Name</strong></div>
                            <div style="color: #64748b; font-size: 13px;">@tariff.Price.ToString("F2") ₽</div>
                        </div>
                    </label>
                }
            </div>
        </div>
    }

    <div class="form-group" style="margin-bottom: 24px;">
        <label><strong>Дата начала</strong></label>
        <input type="date" class="form-control" value="@beginDateString"
               @onchange="OnBeginDateChanged"
               style="width: 100%; padding: 8px 12px; border: 1px solid #e2e8f0; border-radius: 8px; margin-top: 4px;" />
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 8px;">
        <RadzenButton Text="Отмена" ButtonStyle="ButtonStyle.Secondary" Click="@(() => DialogService.Close(null))" />
        <RadzenButton Text="Подключить" ButtonStyle="ButtonStyle.Primary" Click="@HandleConnect" Disabled="@(!canConnect)" />
    </div>
</RadzenCard>

@code {
    private List<ServiceOption> services = new();
    private List<TariffPlanOption> tariffPlans = new();
    private Guid selectedServiceId = Guid.Empty;
    private Guid selectedTariffPlanId = Guid.Empty;
    private bool canConnect;
    private string beginDateString = DateTimeOffset.UtcNow.LocalDateTime.ToString("yyyy-MM-dd");
    private bool isLoadingTariffs;

    [Parameter]
    public Guid ContractId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadServicesAsync();
    }

    private void UpdateCanConnect()
    {
        canConnect = selectedServiceId != Guid.Empty && selectedTariffPlanId != Guid.Empty;
    }

    private async Task LoadServicesAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            var response = await client.GetAsync("api/v1/Services/active");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<ServiceOption>>();
                if (result != null)
                    services = result;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading services: {ex.Message}");
        }
    }

    private async Task OnServiceChanged(ChangeEventArgs e)
    {
        selectedTariffPlanId = Guid.Empty;
        tariffPlans.Clear();
        UpdateCanConnect();

        if (!Guid.TryParse(e.Value?.ToString(), out var serviceId) || serviceId == Guid.Empty)
        {
            selectedServiceId = Guid.Empty;
            UpdateCanConnect();
            StateHasChanged();
            return;
        }

        selectedServiceId = serviceId;
        UpdateCanConnect();

        isLoadingTariffs = true;
        StateHasChanged();

        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            var response = await client.GetAsync($"api/v1/TariffPlans/by-service/active/{selectedServiceId}");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<List<TariffPlanOption>>();
                if (result != null)
                    tariffPlans = result;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading tariffs: {ex.Message}");
        }
        finally
        {
            isLoadingTariffs = false;
            UpdateCanConnect();
            StateHasChanged();
        }
    }

    private void SelectTariff(Guid tariffId)
    {
        selectedTariffPlanId = tariffId;
        UpdateCanConnect();
        StateHasChanged();
    }

    private void OnBeginDateChanged(ChangeEventArgs e)
    {
        beginDateString = e.Value?.ToString() ?? DateTimeOffset.UtcNow.LocalDateTime.ToString("yyyy-MM-dd");
    }

    private async Task HandleConnect()
    {
        if (!canConnect) return;

        if (!DateTimeOffset.TryParse(beginDateString, null, System.Globalization.DateTimeStyles.AdjustToUniversal, out var beginDate))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Ошибка",
                Detail = "Укажите корректную дату начала"
            });
            return;
        }

        DialogService.Close(new ConnectServiceDialogResult
        {
            ServiceId = selectedServiceId,
            TariffPlanId = selectedTariffPlanId,
            BeginDate = beginDate
        });
    }
}
