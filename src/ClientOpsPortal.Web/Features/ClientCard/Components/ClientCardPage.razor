@page "/manager/client-card/{AbonentId:guid}"
@attribute [Authorize(Roles = "Manager")]

@using ClientOpsPortal.Web.Features.ClientCard.Models
@using ClientOpsPortal.Web.Features.ClientCard.Services
@using ClientOpsPortal.Web.Features.ClientCard.Components
@using ClientOpsPortal.Web.Features.SharedDialog.EditAbonentDialog
@using ClientOpsPortal.Web.Features.SharedDialog.EditAbonentDialog.Models
@using ClientOpsPortal.Web.Features.Shared.Notification

@inject IClientCardService ClientCardService
@inject NavigationManager Navigation
@inject DialogService DialogService
@inject AppNotificationService NotificationService

<div class="page-container">
    <div class="card">
        <div class="card-header">
            <div>
                <h3 class="card-title">Карточка клиента</h3>
                <p class="card-subtitle">Управление данными абонента и договорами</p>
            </div>
            <button class="btn btn-secondary" type="button" @onclick="GoBack">
                ← Назад
            </button>
        </div>

        @if (isLoading)
        {
            <div class="loading-container">
                <div class="loading-spinner"></div>
                <p>Загрузка данных...</p>
            </div>
        }
        else if (abonent == null)
        {
            <div class="alert alert-danger">
                <span>⚠️</span>
                Абонент не найден
            </div>
        }
        else
        {
            <!-- Информация об абоненте -->
            <div class="row">
                <div class="col-md-6">
                    <div class="info-card">
                        <div class="info-card-header">
                            <h4 class="info-card-title">Информация об абоненте</h4>
                            <button class="btn btn-secondary btn-sm" type="button" @onclick="OpenEditDialog">
                                Редактировать
                            </button>
                        </div>

                        <div class="info-grid">
                            <div class="info-item">
                                <span class="info-label">Лицевой счет</span>
                                <span class="info-value">@abonent.AccountNumber</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">ФИО</span>
                                <span class="info-value">@abonent.FullName</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Идентификационный номер</span>
                                <span class="info-value">@abonent.IdentificationNumber</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Договоры -->
                <div class="col-md-6">
                    <div class="info-card">
                        <div class="info-card-header">
                            <h4 class="info-card-title">Договоры</h4>
                            <button class="btn btn-primary btn-sm" type="button" @onclick="OpenCreateContractDialog">
                                Новый договор
                            </button>
                        </div>

                        @if (contracts.Count == 0)
                        {
                            <div class="empty-state-small">
                                <span class="empty-icon-small">📋</span>
                                <p>Нет договоров</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var contract in contracts)
                            {
                                <div class="contract-item">
                                    <div class="contract-item-header" @onclick="() => ToggleContract(contract.Id)">
                                        <div class="contract-item-info">
                                            <strong>Договор № @contract.ContractNumber</strong>
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            @if (contract.IsActive)
                                            {
                                                <button class="btn btn-primary btn-sm" type="button"
                                                        @onclick:stopPropagation
                                                        @onclick="() => OpenConnectServiceDialog(contract.Id)"
                                                        title="Подключить услугу">
                                                    Подключить
                                                </button>
                                                <button class="btn btn-danger btn-sm" type="button"
                                                        @onclick:stopPropagation
                                                        @onclick="() => ConfirmCloseContract(contract.Id, contract.ContractNumber)"
                                                        title="Закрыть договор">
                                                    Закрыть
                                                </button>
                                            }
                                            <span class="contract-toggle">▼</span>
                                        </div>
                                    </div>

                                    @if (expandedContractId == contract.Id)
                                    {
                                        <div class="contract-subscriptions">
                                            @{
                                                var subs = GetSubscriptionsForContract(contract.Id);
                                            }
                                            @if (subs.Count == 0)
                                            {
                                                <div class="empty-state-small" style="padding: 16px;">
                                                    <p style="font-size: 13px;">Нет подключенных услуг</p>
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (var sub in subs)
                                                {
                                                    <div class="subscription-item">
                                                        <div style="flex: 1;">
                                                            <div class="subscription-name">@sub.ServiceName</div>
                                                            <div class="subscription-details">
                                                                Тариф: @sub.TariffPlanName
                                                                <br />
                                                                с @sub.BeginDate.LocalDateTime.ToString("dd.MM.yyyy")
                                                                @if (sub.EndDate.HasValue)
                                                                {
                                                                    <span>по @sub.EndDate.Value.LocalDateTime.ToString("dd.MM.yyyy")</span>
                                                                }
                                                            </div>
                                                            <span class="badge @(sub.IsActive ? "badge-success" : "badge-secondary")" style="font-size: 11px; margin-top: 4px;">
                                                                @(sub.IsActive ? "Активна" : "Отключена")
                                                            </span>
                                                        </div>
                                                        <div style="display: flex; gap: 4px; flex-shrink: 0; align-items: center; position: relative;">
                                                            <button class="btn btn-secondary btn-sm" type="button"
                                                                    @onclick="() => ShowSubscriptionHistory(sub.Id)"
                                                                    title="История изменений">
                                                                История
                                                            </button>
                                                            @if (sub.IsActive)
                                                            {
                                                                <div class="dropdown-wrapper" @onclick:stopPropagation>
                                                                    <button class="btn btn-secondary btn-sm dropdown-toggle"
                                                                            type="button"
                                                                            @onclick="() => ToggleDropdown(sub.Id)"
                                                                            title="Действия">
                                                                        ⋯
                                                                    </button>
                                                                    @if (activeDropdownId == sub.Id)
                                                                    {
                                                                        <div class="dropdown-menu @GetDropdownPosition(sub)">
                                                                            <button class="dropdown-item"
                                                                                    type="button"
                                                                                    @onclick="() => { activeDropdownId = null; OpenChangeTariffDialog(sub); }">
                                                                                Сменить тариф
                                                                            </button>
                                                                            <button class="dropdown-item dropdown-item-danger"
                                                                                    type="button"
                                                                                    @onclick="() => { activeDropdownId = null; ConfirmCancelSubscription(sub); }">
                                                                                Отключить
                                                                            </button>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- История по всем договорам -->
            <AllHistoryTable @ref="historyTable" AbonentId="@AbonentId" />
        }
    </div>
</div>

<!-- Диалог истории изменений одной услуги -->
@if (showHistoryModal)
{
    <SubscriptionHistoryDialog SubscriptionId="@selectedSubscriptionId"
                               ServiceName="@selectedServiceName"
                               TariffPlanName="@selectedTariffPlanName"
                               BeginDate="@selectedServiceBeginDate"
                               OnClose="CloseHistoryModal" />
}

@code {
    [Parameter] public Guid AbonentId { get; set; }

    private AbonentDetail? abonent;
    private List<ContractItem> contracts = new();
    private Dictionary<Guid, List<SubscriptionItem>> subscriptionsByContract = new();
    private Guid? expandedContractId;
    private bool isLoading = true;

    private bool showHistoryModal = false;
    private string selectedServiceName = string.Empty;
    private string selectedTariffPlanName = string.Empty;
    private DateTimeOffset selectedServiceBeginDate = DateTimeOffset.Now;
    private Guid selectedSubscriptionId = Guid.Empty;
    private AllHistoryTable? historyTable;
    private Guid? activeDropdownId = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            abonent = await ClientCardService.GetAbonentAsync(AbonentId);
            if (abonent != null)
            {
                var contractList = await ClientCardService.GetContractsAsync(AbonentId);
                contracts = contractList.Where(c => c.EndDate == null || c.EndDate > DateTimeOffset.UtcNow).ToList();
                subscriptionsByContract.Clear();
            }
        }
        catch
        {
            abonent = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private List<SubscriptionItem> GetSubscriptionsForContract(Guid contractId)
    {
        return subscriptionsByContract.TryGetValue(contractId, out var subs) ? subs : new();
    }

    private async Task ToggleContract(Guid contractId)
    {
        if (expandedContractId == contractId)
        {
            expandedContractId = null;
            StateHasChanged();
            return;
        }

        expandedContractId = contractId;

        if (!subscriptionsByContract.ContainsKey(contractId))
        {
            try
            {
                var subs = await ClientCardService.GetSubscriptionsByContractAsync(contractId);
                subscriptionsByContract[contractId] = subs.ToList();
            }
            catch
            {
                subscriptionsByContract[contractId] = new();
            }
        }
        StateHasChanged();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/manager/abonents");
    }

    private async Task OpenEditDialog()
    {
        if (abonent == null) return;

        var result = await DialogService.OpenAsync<EditAbonentDialog>(
            "Редактирование абонента",
            new Dictionary<string, object?>
            {
                { "IsEditMode", true },
                { "LastName", abonent.LastName },
                { "FirstName", abonent.FirstName },
                { "MiddleName", abonent.MiddleName ?? string.Empty },
                { "IdentificationNumber", abonent.IdentificationNumber }
            },
            new DialogOptions { Width = "500px", CloseDialogOnOverlayClick = false, Resizable = true, Draggable = true }
        );

        if (result is EditAbonentDialogResult dialogResult)
        {
            await HandleUpdateAbonent(dialogResult);
        }
    }

    private async Task HandleUpdateAbonent(EditAbonentDialogResult data)
    {
        var model = new AbonentRequest
        {
            LastName = data.LastName,
            FirstName = data.FirstName,
            MiddleName = data.MiddleName,
            IdentificationNumber = data.IdentificationNumber
        };

        var success = await ClientCardService.UpdateAbonentAsync(AbonentId, model);
        if (success)
        {
            await LoadDataAsync();
            NotificationService.ShowSuccess("Данные абонента обновлены");
        }
        else
        {
            NotificationService.ShowError("Не удалось обновить данные абонента");
        }
    }

    private async Task OpenCreateContractDialog()
    {
        var result = await DialogService.OpenAsync<CreateContractDialog>(
            "Новый договор",
            new Dictionary<string, object?>
            {
                { "ContractNumber", string.Empty },
                { "BeginDate", DateTimeOffset.UtcNow }
            },
            new DialogOptions
            {
                Width = "500px",
                CloseDialogOnOverlayClick = false,
                Resizable = true,
                Draggable = true
            }
        );

        if (result is CreateContractDialogResult dialogResult)
        {
            await HandleCreateContract(dialogResult);
        }
    }

    private async Task HandleCreateContract(CreateContractDialogResult data)
    {
        var model = new CreateContractModel
        {
            ContractNumber = data.ContractNumber,
            AbonentId = AbonentId,
            BeginDate = data.BeginDate
        };

        var success = await ClientCardService.CreateContractAsync(model);
        if (success)
        {
            NotificationService.ShowSuccess("Договор создан");
            await LoadDataAsync();
        }
        else
        {
            NotificationService.ShowError("Не удалось создать договор");
        }
    }

    private async Task OpenConnectServiceDialog(Guid contractId)
    {
        var result = await DialogService.OpenAsync<ConnectServiceDialog>(
            "Подключение услуги",
            new Dictionary<string, object?>
            {
                { "ContractId", contractId }
            },
            new DialogOptions
            {
                Width = "550px",
                CloseDialogOnOverlayClick = false,
                Resizable = true,
                Draggable = true
            }
        );

        if (result is ConnectServiceDialogResult dialogResult)
        {
            await HandleConnectService(contractId, dialogResult);
        }
    }

    private async Task HandleConnectService(Guid contractId, ConnectServiceDialogResult data)
    {
        var model = new ConnectServiceModel
        {
            ContractId = contractId,
            ServiceId = data.ServiceId,
            TariffPlanId = data.TariffPlanId,
            BeginDate = data.BeginDate
        };

        var success = await ClientCardService.ConnectServiceAsync(model);
        if (success)
        {
            NotificationService.ShowSuccess("Услуга подключена");

            await LoadDataAsync();

            if (expandedContractId == contractId)
            {
                var subs = await ClientCardService.GetSubscriptionsByContractAsync(contractId);
                subscriptionsByContract[contractId] = subs.ToList();
            }

            if (historyTable != null)
                await historyTable.RefreshHistoryAsync();

            StateHasChanged();
        }
        else
        {
            NotificationService.ShowError("Не удалось подключить услугу");
        }
    }

    private async Task ShowSubscriptionHistory(Guid subscriptionId)
    {
        selectedSubscriptionId = subscriptionId;

        foreach (var contract in contracts)
        {
            var subs = GetSubscriptionsForContract(contract.Id);
            var sub = subs.FirstOrDefault(s => s.Id == subscriptionId);
            if (sub != null)
            {
                selectedServiceName = sub.ServiceName;
                selectedTariffPlanName = sub.TariffPlanName;
                selectedServiceBeginDate = sub.BeginDate;
                break;
            }
        }

        showHistoryModal = true;
        StateHasChanged();
    }

    private async Task CloseHistoryModal()
    {
        showHistoryModal = false;
        StateHasChanged();
    }

    private async Task ConfirmCancelSubscription(SubscriptionItem subscription)
    {
        var result = await DialogService.OpenAsync<DeleteConfirmDialog>(
            "Подтверждение отключения",
            new Dictionary<string, object?>
            {
                { "Title", "Подтверждение отключения" },
                { "Message", $"Вы уверены, что хотите отключить услугу \"{subscription.ServiceName}\"?" },
                { "Detail", "Это действие отключит услугу и прекратит её использование." },
                { "ConfirmText", "Да, отключить" },
                { "CancelText", "Отмена" }
            },
            new DialogOptions
            {
                Width = "450px",
                CloseDialogOnOverlayClick = false,
                Resizable = true,
                Draggable = true
            }
        );

        if (result is bool isConfirmed && isConfirmed)
        {
            await HandleCancelSubscription(subscription);
        }
    }

    private async Task HandleCancelSubscription(SubscriptionItem subscription)
    {
        var success = await ClientCardService.CancelSubscriptionAsync(subscription.Id);
        if (success)
        {
            NotificationService.ShowSuccess($"Услуга \"{subscription.ServiceName}\" отключена");

            await LoadDataAsync();

            if (expandedContractId == subscription.ContractId)
            {
                var subs = await ClientCardService.GetSubscriptionsByContractAsync(subscription.ContractId);
                subscriptionsByContract[subscription.ContractId] = subs.ToList();              
            }

            if (historyTable != null)
                await historyTable.RefreshHistoryAsync();

            StateHasChanged();
        }
        else
        {
            NotificationService.ShowError("Не удалось отключить услугу");
        }
    }

    private async Task ConfirmCloseContract(Guid contractId, string contractNumber)
    {
        var result = await DialogService.OpenAsync<DeleteConfirmDialog>(
            "Подтверждение закрытия",
            new Dictionary<string, object?>
            {
                { "Title", "Подтверждение закрытия" },
                { "Message", $"Вы уверены, что хотите закрыть договор №{contractNumber}?" },
                { "Detail", "Дата закрытия: сегодня" },
                { "ConfirmText", "Да, закрыть" },
                { "CancelText", "Отмена" }
            },
            new DialogOptions
            {
                Width = "450px",
                CloseDialogOnOverlayClick = false,
                Resizable = true,
                Draggable = true
            }
        );

        if (result is bool isConfirmed && isConfirmed)
        {
            await HandleCloseContract(contractId);
        }
    }

    private async Task HandleCloseContract(Guid contractId)
    {
        try
        {
            var model = new CloseContractModel
            {
                EndDate = DateTimeOffset.UtcNow
            };

            var (success, errorMessage) = await ClientCardService.CloseContractAsync(contractId, model);

            if (success)
            {
                NotificationService.ShowSuccess($"Договор успешно закрыт");

                await LoadDataAsync();

                if (expandedContractId == contractId)
                {
                    expandedContractId = null;
                }

                if (historyTable != null)
                    await historyTable.RefreshHistoryAsync();

                StateHasChanged();
            }
            else
            {
                NotificationService.ShowError(errorMessage ?? "Не удалось закрыть договор");
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Ошибка при закрытии договора.");
        }
    }

    private async Task OpenChangeTariffDialog(SubscriptionItem subscription)
    {
        var result = await DialogService.OpenAsync<ChangeTariffDialog>(
            "Смена тарифного плана",
            new Dictionary<string, object?>
            {
            { "SubscriptionId", subscription.Id },
            { "ServiceName", subscription.ServiceName },
            { "CurrentTariffName", subscription.TariffPlanName },
            { "CurrentTariffId", subscription.TariffPlanId },
            { "ServiceId", subscription.ServiceId }
            },
            new DialogOptions
            {
                Width = "500px",
                CloseDialogOnOverlayClick = false,
                Resizable = true,
                Draggable = true
            }
        );

        if (result is ChangeTariffDialog.ChangeTariffDialogResult dialogResult)
        {
            await HandleChangeTariff(dialogResult);
        }
    }

    private async Task HandleChangeTariff(ChangeTariffDialog.ChangeTariffDialogResult data)
    {
        try
        {
            var success = await ClientCardService.ChangeTariffPlanAsync(data.SubscriptionId, data.NewTariffPlanId);

            if (success)
            {
                NotificationService.ShowSuccess("Тарифный план успешно изменен");

                await LoadDataAsync();

                if (expandedContractId.HasValue)
                {
                    var subs = await ClientCardService.GetSubscriptionsByContractAsync(expandedContractId.Value);
                    subscriptionsByContract[expandedContractId.Value] = subs.ToList();
                }

                if (historyTable != null)
                    await historyTable.RefreshHistoryAsync();

                StateHasChanged();
            }
            else
            {
                NotificationService.ShowError("Не удалось изменить тарифный план");
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowError($"Ошибка при смене тарифа.");
        }
    }

    private void ToggleDropdown(Guid subscriptionId)
    {
        if (activeDropdownId == subscriptionId)
        {
            activeDropdownId = null;
        }
        else
        {
            activeDropdownId = subscriptionId;
        }
        StateHasChanged();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
    }

    private string GetDropdownPosition(SubscriptionItem sub)
    {
        // Определяем позицию подписки в списке
        var index = subscriptionsByContract.Values.SelectMany(x => x).ToList().IndexOf(sub);
        var total = subscriptionsByContract.Values.SelectMany(x => x).Count();

        // Если подписка последняя или предпоследняя - показываем меню вверх
        if (index >= total - 2)
        {
            return "dropdown-up";
        }
        return "dropdown-down";
    }
}