@page "/not-found"

@inject NavigationManager Navigation

<RadzenCard>
    <h3 class="mb-0">Страница не найдена</h3>
    <div class="p-3">
        <p>Запрашиваемая страница не существует</p>
        <RadzenButton Text="На главную" ButtonStyle="ButtonStyle.Primary" Click="@GoHome" />
    </div>
</RadzenCard>

@code {
    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}
