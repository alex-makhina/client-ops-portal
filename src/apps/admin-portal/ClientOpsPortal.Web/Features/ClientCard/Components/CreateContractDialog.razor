@inject DialogService DialogService
@using System.Globalization

<div class="modal-overlay" @onclick="Close">
    <div class="modal-content" @onclick:stopPropagation>
        <div class="modal-header">
            <h3>Новый договор</h3>
            <button class="modal-close" type="button" @onclick="Close">×</button>
        </div>

        <div class="modal-body">
            @if (showError)
            {
                <div class="alert alert-danger">
                    <span>⚠️</span>
                    @errorMessage
                </div>
            }

            <div class="form-grid">
                <div class="form-group" style="grid-column: span 2;">
                    <label class="form-label">Номер договора <span class="required">*</span></label>
                    <input type="text"
                           class="form-control @(showError && (string.IsNullOrWhiteSpace(contractNumber) || !HasNonZeroDigit(contractNumber)) ? "error" : "")"
                           placeholder="Например: Д-001"
                           @bind="contractNumber"
                           @bind:event="oninput" />
                    <span class="form-hint">Уникальный номер договора</span>
                </div>

                <div class="form-group">
                    <label class="form-label">Дата начала</label>
                    <input type="date"
                           class="form-control"
                           value="@beginDate.ToString("yyyy-MM-dd")"
                           @onchange="OnDateChanged" />
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button class="btn btn-secondary" type="button" @onclick="Close">Отмена</button>
            <button class="btn btn-primary" type="button" @onclick="Save">
                Создать
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string ContractNumber { get; set; } = string.Empty;
    [Parameter] public DateTimeOffset BeginDate { get; set; } = DateTimeOffset.UtcNow;

    private string contractNumber = string.Empty;
    private DateTimeOffset beginDate = DateTimeOffset.UtcNow;
    private bool showError;
    private string errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        contractNumber = ContractNumber;
        beginDate = BeginDate;
    }

    private void Close()
    {
        DialogService.Close(null);
    }

    private void OnDateChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        if (DateTime.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt))
        {
            beginDate = new DateTimeOffset(dt, TimeSpan.FromHours(3));
        }
    }

    private bool HasNonZeroDigit(string input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return false;

        foreach (char c in input)
        {
            if (char.IsDigit(c) && c != '0')
                return true;
        }
        return false;
    }

    private async Task Save()
    {
        showError = false;

        if (string.IsNullOrWhiteSpace(contractNumber))
        {
            showError = true;
            errorMessage = "Введите номер договора";
            StateHasChanged();
            return;
        }

        if (!HasNonZeroDigit(contractNumber))
        {
            showError = true;
            errorMessage = "Номер договора должен содержать хотя бы одну цифру, отличную от нуля (1-9)";
            StateHasChanged();
            return;
        }

        var result = new CreateContractDialogResult
        {
            ContractNumber = contractNumber.Trim(),
            BeginDate = beginDate
        };

        DialogService.Close(result);
    }
}
