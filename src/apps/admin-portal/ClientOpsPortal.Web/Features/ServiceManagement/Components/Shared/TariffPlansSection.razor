@using ClientOpsPortal.Web.Features.ServiceManagement.Models.Requests

<div class="section">
    <div class="section-header">
        <h4 class="section-title">Тарифные планы</h4>
        <button class="btn-add-tariff" @onclick="OnAddTariff">
            ➕ Добавить тариф
        </button>
    </div>

    @if (TariffPlans.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon">📋</div>
            <p class="empty-state-title">Нет тарифных планов</p>
            <p class="empty-state-description">Нажмите кнопку "Добавить тариф", чтобы создать первый тарифный план</p>
        </div>
    }
    else
    {
        <div class="tariff-list">
            @for (int i = 0; i < TariffPlans.Count; i++)
            {
                var index = i;
                var tariff = TariffPlans[index];
                <TariffPlanCard Model="@tariff"
                                Index="@(index + 1)"
                                OnRemove="@(() => OnRemoveTariff.InvokeAsync(index))" />
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<TariffPlanRequest> TariffPlans { get; set; } = new();
    [Parameter] public EventCallback OnAddTariff { get; set; }
    [Parameter] public EventCallback<int> OnRemoveTariff { get; set; }
}