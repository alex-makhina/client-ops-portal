@using ClientOpsPortal.Web.Features.ServiceManagement.Models.Requests
@using ClientOpsPortal.Web.Features.ServiceManagement.Validators
@using ClientOpsPortal.Web.Features.ServiceManagement.Components.Shared
@inject DialogService DialogService
@inject IJSRuntime JSRuntime

<div class="modal-overlay" id="service-dialog-overlay">
    <div class="modal-content" id="modal-content">
        <div class="modal-header">
            <div class="modal-header-left">
                <h3>@(IsEditMode ? "Редактирование услуги" : "Создание услуги")</h3>
            </div>
            <button class="modal-close" type="button" @onclick="Close">×</button>
        </div>

        <div class="modal-body" id="modal-body">
            @if (showError)
            {
                <div class="alert alert-danger">
                    <span class="alert-icon">⚠️</span>
                    <span>@errorMessage</span>
                </div>
            }

            <ServiceBasicInfo Name="@serviceName"
                              NameChanged="@OnServiceNameChanged"
                              Description="@serviceDescription"
                              DescriptionChanged="@OnServiceDescriptionChanged"
                              BeginDate="@serviceBeginDate"
                              BeginDateChanged="@OnServiceBeginDateChanged"
                              EndDate="@serviceEndDate"
                              EndDateChanged="@OnServiceEndDateChanged" />

            <TariffPlansSection TariffPlans="@tariffPlansList"
                                OnAddTariff="@AddTariffPlan"
                                OnRemoveTariff="@RemoveTariffPlan" />
        </div>

        <div class="modal-footer">
            <button class="btn-cancel" @onclick="Close">Отмена</button>
            <button class="btn-save" @onclick="Save">
                @GetSaveButtonText()
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public Guid ServiceId { get; set; }
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public DateTimeOffset BeginDate { get; set; } = DateTimeOffset.UtcNow;
    [Parameter] public DateTimeOffset? EndDate { get; set; }
    [Parameter] public List<TariffPlanRequest> TariffPlans { get; set; } = new();

    private string serviceName = string.Empty;
    private string serviceDescription = string.Empty;
    private DateTimeOffset serviceBeginDate = DateTimeOffset.UtcNow;
    private DateTimeOffset? serviceEndDate;
    private List<TariffPlanRequest> tariffPlansList = new();

    private bool showError;
    private string errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        serviceName = Name;
        serviceDescription = Description;
        serviceBeginDate = BeginDate;
        serviceEndDate = EndDate;
        tariffPlansList = TariffPlans?.ToList() ?? new List<TariffPlanRequest>();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }

    private async Task OnServiceNameChanged(string value)
    {
        serviceName = value;
        await Task.CompletedTask;
    }

    private async Task OnServiceDescriptionChanged(string value)
    {
        serviceDescription = value;
        await Task.CompletedTask;
    }

    private async Task OnServiceBeginDateChanged(DateTimeOffset value)
    {
        serviceBeginDate = value;
        await Task.CompletedTask;
    }

    private async Task OnServiceEndDateChanged(DateTimeOffset? value)
    {
        serviceEndDate = value;
        await Task.CompletedTask;
    }

    private void Close() => DialogService.Close(null);

    private async Task AddTariffPlan()
    {
        tariffPlansList.Add(new TariffPlanRequest
        {
            Id = Guid.Empty,
            Name = string.Empty,
            Description = string.Empty,
            Price = 0,
            ServiceId = ServiceId,
            BeginDate = DateTimeOffset.UtcNow,
            EndDate = null
        });

        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task RemoveTariffPlan(int index)
    {
        if (index >= 0 && index < tariffPlansList.Count)
        {
            tariffPlansList.RemoveAt(index);
            StateHasChanged();
        }
        await Task.CompletedTask;
    }

    private async Task Save()
    {
        showError = false;

        var serviceError = ServiceTariffValidator.ValidateService(serviceName, serviceDescription, serviceBeginDate, serviceEndDate);
        if (serviceError != null)
        {
            showError = true;
            errorMessage = serviceError;
            return;
        }

        for (int i = 0; i < tariffPlansList.Count; i++)
        {
            var tariffError = ServiceTariffValidator.ValidateTariffPlan(tariffPlansList[i], i);
            if (tariffError != null)
            {
                showError = true;
                errorMessage = tariffError;
                return;
            }
        }

        if (IsEditMode)
        {
            var result = new UpdateServiceRequest
            {
                IsEditMode = true,
                ServiceId = ServiceId,
                Name = serviceName.Trim(),
                Description = serviceDescription.Trim(),
                BeginDate = serviceBeginDate,
                EndDate = serviceEndDate,
                TariffPlans = tariffPlansList.ToList()
            };

            DialogService.Close(result);
        }
        else
        {
            var result = new CreateServiceRequest
            {
                Name = serviceName.Trim(),
                Description = serviceDescription.Trim(),
                BeginDate = serviceBeginDate,
                EndDate = serviceEndDate,
                TariffPlans = tariffPlansList.ToList()
            };

            DialogService.Close(result);
        }
    }

    private string GetSaveButtonText() => IsEditMode ? "Сохранить" : "Создать";
}