@using ClientOpsPortal.Web.Features.Reports.Models
@using ClientOpsPortal.Web.Features.Reports.Services
@using ClientOpsPortal.Web.Features.Reports.Components.Shared

@inject IReportService ReportService
@inject DialogService DialogService

<div class="report-section">
    <div class="report-header">
        <h4>Статус услуг</h4>
        <ExportButton ExportFunction="ExportReportData"
                      FileName="services-status.csv"
                      SuccessMessage="Отчет успешно экспортирован"
                      ErrorMessage="Не удалось экспортировать отчет" />
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="loading-spinner"></div>
            <p>Загрузка данных...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger">
            <span>⚠️</span>
            @errorMessage
        </div>
    }
    else if (data.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">📋</span>
            <p>Нет данных для отображения</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="report-table">
                <thead>
                    <tr>
                        <th>Услуга</th>
                        <th>Статус</th>
                        <th>Всего подписок</th>
                        <th>Активных</th>
                        <th>Неактивных</th>
                        <th>Средняя цена</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in data)
                    {
                        <tr>
                            <td><strong>@item.ServiceName</strong></td>
                            <td>
                                <span class="badge @(item.IsActive ? "badge-success" : "badge-secondary")">
                                    @(item.IsActive ? "Активна" : "Неактивна")
                                </span>
                            </td>
                            <td>@item.TotalSubscriptions</td>
                            <td>@item.ActiveSubscriptions</td>
                            <td>@item.InactiveSubscriptions</td>
                            <td>@item.AverageTariffPrice.ToString("C2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="total-row">
                        <td><strong>Итого</strong></td>
                        <td></td>
                        <td><strong>@data.Sum(x => x.TotalSubscriptions)</strong></td>
                        <td><strong>@data.Sum(x => x.ActiveSubscriptions)</strong></td>
                        <td><strong>@data.Sum(x => x.InactiveSubscriptions)</strong></td>
                        <td><strong>@data.Average(x => x.AverageTariffPrice).ToString("C2")</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

@code {
    private List<ServiceStatusReportItem> data = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            data = await ReportService.GetServicesStatusAsync();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task<byte[]> ExportReportData()
    {
        return await ReportService.ExportReportAsync("services-status");
    }
}