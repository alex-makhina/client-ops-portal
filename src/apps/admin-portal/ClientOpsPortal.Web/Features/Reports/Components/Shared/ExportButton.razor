@using ClientOpsPortal.Web.Features.Shared.Notification

@inject IJSRuntime JSRuntime
@inject AppNotificationService NotificationService

<button class="btn btn-sm btn-secondary" @onclick="HandleExport" disabled="@isExporting">
    @if (isExporting)
    {
        <span>⏳ Экспорт...</span>
    }
    else
    {
        <span>📥 Экспорт CSV</span>
    }
</button>

@code {
    [Parameter] public Func<Task<byte[]>> ExportFunction { get; set; } = null!;
    [Parameter] public string FileName { get; set; } = "export.csv";
    [Parameter] public string ButtonText { get; set; } = "📥 Экспорт CSV";
    [Parameter] public string? SuccessMessage { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    private bool isExporting = false;

    private async Task HandleExport()
    {
        if (ExportFunction == null || isExporting)
            return;

        isExporting = true;
        StateHasChanged();

        try
        {
            var data = await ExportFunction();
            if (data != null && data.Length > 0)
            {
                await SaveAsFile(FileName, data);
            }
            else
            {
                NotificationService.ShowError("Нет данных для экспорта");
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Ошибка при экспорте");
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsFile(string fileName, byte[] data)
    {
        using var stream = new MemoryStream(data);
        using var streamRef = new DotNetStreamReference(stream);
        await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }
}