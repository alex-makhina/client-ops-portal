@namespace ClientOpsPortal.Web.Features.SharedDialog.EditAbonentDialog
@using ClientOpsPortal.Web.Features.SharedDialog.EditAbonentDialog.Models
@inject DialogService DialogService

<div class="modal-overlay" @onclick="Close">
    <div class="modal-content" @onclick:stopPropagation>
        <div class="modal-header">
            <h3>@(IsEditMode ? "Редактирование абонента" : "Создание абонента")</h3>
            <button class="modal-close" type="button" @onclick="Close">×</button>
        </div>

        <div class="modal-body">
            @if (showError)
            {
                <div class="alert alert-danger">
                    <span>⚠️</span>
                    @errorMessage
                </div>
            }

            <div class="form-grid">
                <div class="form-group" style="grid-column: span 2;">
                    <label class="form-label">Фамилия <span class="required">*</span></label>
                    <input type="text"
                           class="form-control @(showError && string.IsNullOrWhiteSpace(lastName) ? "error" : "")"
                           placeholder="Введите фамилию"
                           @bind="lastName"
                           @bind:event="oninput" />
                    <span class="form-hint">От 2 до 50 символов</span>
                </div>

                <div class="form-group" style="grid-column: span 2;">
                    <label class="form-label">Имя <span class="required">*</span></label>
                    <input type="text"
                           class="form-control @(showError && string.IsNullOrWhiteSpace(firstName) ? "error" : "")"
                           placeholder="Введите имя"
                           @bind="firstName"
                           @bind:event="oninput" />
                    <span class="form-hint">От 2 до 50 символов</span>
                </div>

                <div class="form-group" style="grid-column: span 2;">
                    <label class="form-label">Отчество</label>
                    <input type="text"
                           class="form-control"
                           placeholder="Введите отчество (необязательно)"
                           @bind="middleName"
                           @bind:event="oninput" />
                    <span class="form-hint">Необязательное поле</span>
                </div>

                <div class="form-group" style="grid-column: span 2;">
                    <label class="form-label">Идентификационный номер <span class="required">*</span></label>
                    <input type="text"
                           class="form-control @(showError && string.IsNullOrWhiteSpace(identificationNumber) ? "error" : "")"
                           placeholder="Введите идентификационный номер"
                           @bind="identificationNumber"
                           @bind:event="oninput" />
                    <span class="form-hint">Только заглавные буквы и цифры, от 5 до 20 символов</span>
                </div>

                @if (!IsEditMode)
                {
                    <div class="form-group" style="grid-column: span 2;">
                        <label class="form-label">Email <span class="required">*</span></label>
                        <input type="email"
                               class="form-control @(showError && string.IsNullOrWhiteSpace(email) ? "error" : "")"
                               placeholder="Введите email"
                               @bind="email"
                               @bind:event="oninput" />
                        <span class="form-hint">Пример: user@example.com</span>
                    </div>
                }
            </div>
        </div>

        <div class="modal-footer">
            <button class="btn btn-secondary" type="button" @onclick="Close">Отмена</button>
            <button class="btn btn-primary" type="button" @onclick="Save">
                @(IsEditMode ? "Сохранить" : "Создать")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string LastName { get; set; } = string.Empty;
    [Parameter] public string FirstName { get; set; } = string.Empty;
    [Parameter] public string? MiddleName { get; set; }
    [Parameter] public string IdentificationNumber { get; set; } = string.Empty;
    [Parameter] public string Email { get; set; } = string.Empty;
    [Parameter] public bool IsEditMode { get; set; } = false;

    private string lastName = string.Empty;
    private string firstName = string.Empty;
    private string? middleName;
    private string identificationNumber = string.Empty;
    private string email = string.Empty;
    private bool showError;
    private string errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        lastName = LastName ?? string.Empty;
        firstName = FirstName ?? string.Empty;
        middleName = MiddleName;
        identificationNumber = IdentificationNumber ?? string.Empty;
        email = Email ?? string.Empty;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }

    private void Close()
    {
        DialogService.Close(null);
    }

    private async Task Save()
    {
        showError = false;
        var errors = new List<string>();

        if (string.IsNullOrWhiteSpace(lastName))
            errors.Add("Введите фамилию");
        else if (lastName.Length < 2 || lastName.Length > 50)
            errors.Add("Фамилия должна содержать от 2 до 50 символов");
        else if (!System.Text.RegularExpressions.Regex.IsMatch(lastName, @"^[А-Яа-яЁёA-Za-z\s\-]+$"))
            errors.Add("Фамилия может содержать только буквы, пробелы и дефисы");

        if (string.IsNullOrWhiteSpace(firstName))
            errors.Add("Введите имя");
        else if (firstName.Length < 2 || firstName.Length > 50)
            errors.Add("Имя должно содержать от 2 до 50 символов");
        else if (!System.Text.RegularExpressions.Regex.IsMatch(firstName, @"^[А-Яа-яЁёA-Za-z\s\-]+$"))
            errors.Add("Имя может содержать только буквы, пробелы и дефисы");

        if (!string.IsNullOrEmpty(middleName))
        {
            if (middleName.Length > 50)
                errors.Add("Отчество не может быть длиннее 50 символов");
            else if (!System.Text.RegularExpressions.Regex.IsMatch(middleName, @"^[А-Яа-яЁёA-Za-z\s\-]*$"))
                errors.Add("Отчество может содержать только буквы, пробелы и дефисы");
        }

        if (string.IsNullOrWhiteSpace(identificationNumber))
            errors.Add("Введите идентификационный номер");
        else if (identificationNumber.Length < 5 || identificationNumber.Length > 20)
            errors.Add("Идентификационный номер должен содержать от 5 до 20 символов");
        else if (!System.Text.RegularExpressions.Regex.IsMatch(identificationNumber, @"^[A-Z0-9]+$"))
            errors.Add("Идентификационный номер может содержать только заглавные буквы и цифры");

        if (!IsEditMode)
        {
            if (string.IsNullOrWhiteSpace(email))
                errors.Add("Введите email");
            else if (!System.Text.RegularExpressions.Regex.IsMatch(email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
                errors.Add("Введите корректный email (пример: user@example.com)");
            else if (email.Length > 100)
                errors.Add("Email не может быть длиннее 100 символов");
        }

        if (errors.Count > 0)
        {
            showError = true;
            errorMessage = string.Join("; ", errors);
            StateHasChanged();
            return;
        }

        var result = new EditAbonentDialogResult
        {
            LastName = lastName.Trim(),
            FirstName = firstName.Trim(),
            MiddleName = middleName?.Trim(),
            IdentificationNumber = identificationNumber.Trim(),
            Email = email.Trim(),
            IsEditMode = IsEditMode
        };

        DialogService.Close(result);
    }
}