@page "/login"

@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="login-page">
    <div class="login-card card">
        <div class="login-header">
            <h2 class="login-title">Вход в систему</h2>
            <p class="login-subtitle">ClientOps Portal</p>
        </div>

        @if (showError)
        {
            <div class="alert alert-danger">
                <span>⚠️</span>
                @errorMessage
            </div>
        }

        <div class="login-form">
            <div class="form-group">
                <label class="form-label">Логин</label>
                <input type="text"
                       class="form-control @(showError ? "error" : "")"
                       placeholder="Введите логин"
                       @bind="login"
                       @bind:event="oninput" />
            </div>

            <div class="form-group">
                <label class="form-label">Пароль</label>
                <input type="password"
                       class="form-control @(showError ? "error" : "")"
                       placeholder="Введите пароль"
                       @bind="password"
                       @bind:event="oninput" />
            </div>

            <button class="btn btn-primary w-100"
                    @onclick="HandleLogin"
                    disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="loading-spinner-small"></span>
                    <span>Вход...</span>
                }
                else
                {
                    <span>Войти</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    private string login = string.Empty;
    private string password = string.Empty;
    private bool isLoading;
    private bool showError;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(login) || string.IsNullOrWhiteSpace(password))
        {
            showError = true;
            errorMessage = "Введите логин и пароль";
            return;
        }

        isLoading = true;
        showError = false;

        try
        {
            var result = await AuthService.LoginAsync(login, password);
            if (result != null)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                showError = true;
                errorMessage = "Неверный логин или пароль";
            }
        }
        catch (Exception ex)
        {
            showError = true;
            errorMessage = $"Ошибка подключения: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}